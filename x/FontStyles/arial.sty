%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% FontStyles/arial.sty
%% NOVA thesis configuration file
%%
%% Customization of fonts to use Arial fontset
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\typeout{NT FILE FontStyles/arial.sty}%



%%=======================================================================
%% FONT VERIFICATION
%%=======================================================================

\ntcheckfonts{Arial}{Regular,Italic,Bold,BoldItalic}


%%=======================================================================
%% FONT SELECTION
%%=======================================================================

\setmainfont{Arial}[
  Path           = \DIRFONTSTYLES/Fonts/,
  Extension      = .ttf,
  Ligatures      = TeX,
  UprightFont    = *-Regular,
  ItalicFont     = *-Italic,
  BoldFont       = *-Bold,
  BoldItalicFont = *-BoldItalic,
]

% Arial is a sans-serif; use as both roman and sans
\setsansfont{Arial}[
  Path           = \DIRFONTSTYLES/Fonts/,
  Extension      = .ttf,
  Ligatures      = TeX,
  UprightFont    = *-Regular,
  ItalicFont     = *-Italic,
  BoldFont       = *-Bold,
  BoldItalicFont = *-BoldItalic,
]

% Use Liberation Mono as fallback for monospace (or Courier)
\setmonofont[
  Scale          = 0.95,
  Ligatures      = TeX,
]{Courier New}

% Math font using newtxmath for consistency
\RequirePackage[libertine]{newtxmath}
