%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% FontStyles/jost.sty
%% NOVA thesis configuration file
%%
%% Customization of fonts to use Jost font set
%% Requires XeLaTeX or LuaLaTeX
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\typeout{NT FILE FontStyles/jost.sty}%


%%=======================================================================
%% ENGINE CHECK
%%=======================================================================

\ifxeorlua{}{%
  \ClassError{novathesis}
             {Font~style~"jost"~is~not~compatible~with~pdfLaTeX.~Please~use~XeLaTeX~or~LuaLaTeX}
             {Please~use~XeLaTeX~or~LuaLaTeX}%
}


%%=======================================================================
%% FONT VERIFICATION
%%=======================================================================

\ntcheckfonts{Jost}{Regular,Bold,Italic,BoldItalic}


%%=======================================================================
%% FONT VERIFICATION
%%=======================================================================

\RequirePackage{fontspec}


%%=======================================================================
%% FONT SELECTION
%%=======================================================================

% Jost - Elegant sans serif font
\setmainfont{Jost}[
  Path           = \DIRFONTSTYLES/Fonts/,
  Ligatures = {TeX, Common, Discretionary},
  Extension      = .ttf,
  Scale     = MatchLowercase, % Automatically scales to match surrounding text height
  UprightFont    = *-Regular,
  ItalicFont     = *-Italic,
  BoldFont       = *-Bold,
  BoldItalicFont = *-BoldItalic,
]

% TeX Gyre Heros for sans (pairs well with Jost)
\setsansfont{Jost}[
  Path           = \DIRFONTSTYLES/Fonts/,
  Ligatures = {TeX, Common, Discretionary},
  Extension      = .ttf,
  Scale     = MatchLowercase, % Automatically scales to match surrounding text height
  UprightFont    = *-Regular,
  ItalicFont     = *-Italic,
  BoldFont       = *-Bold,
  BoldItalicFont = *-BoldItalic,
]

% TeX Gyre Cursor for monospace
  \setmonofont{JetBrains Mono}
  [ LetterSpace=-3.0,
    Ligatures = {TeX},
    Scale = MatchLowercase, % Automatically scales to match surrounding text height
  ]

