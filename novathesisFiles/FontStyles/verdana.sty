%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% FontStyles/verdana.sty
%% NOVA thesis configuration file
%%
%% Customization of fonts to use Verdana fontset
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\typeout{NT FILE FontStyles/verdana.sty}%


%%=======================================================================
%% ENGINE CHECK
%%=======================================================================

\NTRequireEngine{style/font=verdana}{lua,xe}


%%=======================================================================
%% FONT VERIFICATION
%%=======================================================================

\ntcheckfonts{VerdanaPro}{Regular,Italic,Bold,BoldItalic}


%%=======================================================================
%% FONT SELECTION
%%=======================================================================

\setmainfont{VerdanaPro}[
  Path           = \DIRFONTSTYLES/Fonts/,
  Extension      = .ttf,
  Ligatures      = TeX,
  UprightFont    = *-Regular,
  ItalicFont     = *-Italic,
  BoldFont       = *-Bold,
  BoldItalicFont = *-BoldItalic,
]
\renewcommand*{\FontPrettyName}{Verdana}

% Verdana is a sans-serif; use as both roman and sans
\setsansfont{VerdanaPro}[
  Path           = \DIRFONTSTYLES/Fonts/,
  Extension      = .ttf,
  Ligatures      = TeX,
  UprightFont    = *-Regular,
  ItalicFont     = *-Italic,
  BoldFont       = *-Bold,
  BoldItalicFont = *-BoldItalic,
]
\renewcommand*{\FontPrettyNameSans}{Verdana}

% Use Courier New as fallback for monospace
\setmonofont[
  Scale          = 0.95,
  Ligatures      = TeX,
]{Courier New}
\renewcommand*{\FontPrettyNameMono}{Courier New}

% Math font using newtxmath for consistency
\RequirePackage[libertine]{newtxmath}
\renewcommand*{\FontPrettyNameMath}{Libertine (newtxmath)}
