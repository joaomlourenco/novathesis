%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% FontStyles/palatino-gyre-pagella.sty
%% NOVA thesis configuration file
%%
%% Customization of font to use a Palatino-like font style
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\typeout{NT FILE FontStyles/palatino-gyre-pagella.sty}%


%%=======================================================================
%% ENGINE CHECK
%%=======================================================================

\ifxeorlua{}{%
  \ClassError{novathesis}
             {Font~style~"Palatino~Gyre~Pagella"~is~not~compatible~with~pdfLaTeX.~Please~use~XeLaTeX~or~LuaLaTeX}
             {Please~use~XeLaTeX~or~LuaLaTeX}%
}


%%=======================================================================
%% FONT SELECTION
%%=======================================================================

\IfFontExistsTF{TeX Gyre Pagella}{
  \setmainfont{TeX Gyre Pagella}[
    Scale=1.0,
    Ligatures={Common,Discretionary,TeX}
  ]
  \IfFontExistsTF{TeX Gyre Pagella Math}{
    \setmathfont{TeX Gyre Pagella Math}
  }{}
  
  % Use TeX Gyre Heros for sans (pairs well with Pagella)
  \setsansfont{TeX Gyre Heros}[
    Scale=0.92,
    Ligatures=TeX
  ]
  % Use TeX Gyre Cursor for mono
  \setmonofont{TeX Gyre Cursor}[
    Scale=0.95,
    Ligatures=TeX
  ]
}{
  \PackageError{novathesis}{'TeX Gyre Pagella' font not found. Please select another font style in '0-Config/1_novathesis.tex'}{}
}
