%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% other/huberlin/defaults.clo
%% NOVA thesis configuration file
%%
%% Customization for Humboldt-Universität zu Berlin (strings and cover)
%%
%% Based on the official title-page sample provided by the school
%% (Images/WORD_Deckblatt_Abschlussarbeit_Muster.pdf), which is German-only
%% and faculty-specific (shows "Philosophische Fakultät" as one example among
%% many HU faculties). This file keeps the same required content but styles
%% it like the rest of novathesis (logo + accent colour) and supports every
%% doctype/language the framework already knows, instead of hard-coding one
%% faculty or one degree type.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\typeout{NT FILE other/huberlin/defaults.clo}%


%%=======================================================================
%% METADATA & GLOBAL PROPERTIES
%%=======================================================================

% All LaTeX engines (pdfLaTeX, XeLaTeX, LuaLaTeX) are accepted
\AddValidProcessor{other/huberlin}{pdf,lua,xe}

\ifdocfinal{\ntsetup{print/frontpage=true}}{}


%%=======================================================================
%% COLOURS
%%=======================================================================

% Sampled from Images/Huberlin-logo.svg (fill #165096)
\definecolor{huberlinblue}{RGB}{22,80,150}


%%=======================================================================
%% STRINGS (UNIVERSITY & SCHOOL)
%%=======================================================================

\SetUniversity*(de)={Humboldt-Universität zu Berlin}
\SetUniversity*(en)={Humboldt-Universität zu Berlin}

% Faculty: HU has many; the sample shows "Philosophische Fakultät" as just
% one example. Override in 0-Config/3_cover.tex with your own faculty, e.g.
%   \SetSchool*(de)={Philosophische Fakultät}
%   \SetSchool*(en)={Faculty of Arts and Humanities}
% (0-Config/3_cover.tex is read AFTER this file, so it takes precedence.)
\SetSchool*(de)={Fakultät}
\SetSchool*(en)={Faculty}

% Institute/department: also override in 0-Config/3_cover.tex if needed,
% e.g. \SetDepartment*(de)={Institut für Informatik}. Falls back to the
% framework's generic placeholder ("Name des Fachbereichs") if left unset.


%%=======================================================================
%% CUSTOM FIELDS: AUTHOR'S DATE & PLACE OF BIRTH (optional)
%%=======================================================================

% The HU cover sample asks for "geb. am <date> in <place>". Both fields are
% optional: leave them unset and the line is omitted entirely. To set them,
% add to 0-Config/3_cover.tex:
%
%   \SetAuthorBirthDate*()={1998-03-03}    % ISO format, rendered via \PrintDateISO
%   \SetAuthorBirthPlace*(de)={Berlin}     % one line per cover language you use
%
% AuthorBirthDate has no language key: like \GetDocDate, the stored value is
% the same regardless of cover language -- only its rendering is localized.
%
% \NewMemStore{AuthorBirthDate}/{AuthorBirthPlace} live in nt-core.sty, NOT
% here: they're referenced from 0-Config/3_cover.tex, which loads regardless
% of the selected school, so the commands must exist unconditionally (see
% the comment there) even though only this school's cover renders them.

\NewMemStore{BirthDateLabel}
\SetBirthDateLabel*(de)={geb.\ am}
\SetBirthDateLabel*(en)={born on}

\NewMemStore{BirthPlaceLabel}
\SetBirthPlaceLabel*(de)={in}
\SetBirthPlaceLabel*(en)={in}


%%=======================================================================
%% EXAMINERS ("Gutachter/in")
%%=======================================================================

% HU cover asks for "1. Gutachter/in" and "2. Gutachter/in" -- reuse the
% generic adviser roles (a = 1st, c = 2nd) and just relabel them for this
% school. Note: it's the *bare* (non-"pref") AdviserString that feeds the
% per-role group title in \ntprintpersons' two-column layout (see
% ulisboa/ist for the same pattern with plain "Supervisor"/"Co-supervisor").
\SetAdviserString*(a,1,m,de)={1.\ Gutachter}
\SetAdviserString*(a,1,f,de)={1.\ Gutachterin}
\SetAdviserString*(a,2,m,de)={1.\ Gutachter}
\SetAdviserString*(a,2,f,de)={1.\ Gutachterinnen}
\SetAdviserString*(c,1,m,de)={2.\ Gutachter}
\SetAdviserString*(c,1,f,de)={2.\ Gutachterin}
\SetAdviserString*(c,2,m,de)={2.\ Gutachter}
\SetAdviserString*(c,2,f,de)={2.\ Gutachterinnen}

\SetAdviserString*(a,1,m,en)={1st Examiner}
\SetAdviserString*(a,1,f,en)={1st Examiner}
\SetAdviserString*(a,2,m,en)={1st Examiners}
\SetAdviserString*(a,2,f,en)={1st Examiners}
\SetAdviserString*(c,1,m,en)={2nd Examiner}
\SetAdviserString*(c,1,f,en)={2nd Examiner}
\SetAdviserString*(c,2,m,en)={2nd Examiners}
\SetAdviserString*(c,2,f,en)={2nd Examiners}


%%=======================================================================
%% DISSERTATION STRING (doctype + degree line)
%%=======================================================================

% "<Bachelorarbeit/Masterarbeit/Dissertation>
%  zur Erlangung des akademischen Grades
%  <DegreeName, e.g. Bachelor of Arts (B.A.) im Fach Philosophie>"
% \GetDegreeName is the same free-text field used by other schools (e.g.
% ulisboa/fcul); set it per-document in 0-Config/3_cover.tex.
\SetDissertationString(bsc,de)={\GetDoctypeString(bsc,\@LANG@COVER)\\
  zur Erlangung des akademischen Grades\\
  \GetDegreeName(\@LANG@COVER)}
\SetDissertationString(msc,de)={\GetDoctypeString(msc,\@LANG@COVER)\\
  zur Erlangung des akademischen Grades\\
  \GetDegreeName(\@LANG@COVER)}
\SetDissertationString(phd,de)={\GetDoctypeString(phd,\@LANG@COVER)\\
  zur Erlangung des akademischen Grades\\
  \GetDegreeName(\@LANG@COVER)}

\SetDissertationString(bsc,en)={\GetDoctypeString(bsc,\@LANG@COVER)\\
  in fulfillment of the requirements for the degree of\\
  \GetDegreeName(\@LANG@COVER)}
\SetDissertationString(msc,en)={\GetDoctypeString(msc,\@LANG@COVER)\\
  in fulfillment of the requirements for the degree of\\
  \GetDegreeName(\@LANG@COVER)}
\SetDissertationString(phd,en)={\GetDoctypeString(phd,\@LANG@COVER)\\
  in fulfillment of the requirements for the degree of\\
  \GetDegreeName(\@LANG@COVER)}


%%=======================================================================
%% FONTS
%%=======================================================================

\AtEndPreamble{%
  %\LoadHelveticaLikeFont%  % \RequirePackage{gillius2}%
}


%%=======================================================================
%% LAYOUT (MARGINS)
%%=======================================================================

% Set margins for "normal" pages
\SetMargin*(screen,top)={3.5cm}
\SetMargin*(screen,bottom)={2.5cm}
\SetMargin*(screen,left)={3.0cm}
\SetMargin*(screen,right)={3.0cm}
\SetMargin*(paper,top)={3.5cm}
\SetMargin*(paper,bottom)={2.5cm}
\SetMargin*(paper,left)={2.5cm}
\SetMargin*(paper,right)={3.5cm}

% Set margins for cover pages
\SetMargin*(cover,top)={1.5cm}
\SetMargin*(cover,bottom)={1.5cm}
\SetMargin*(cover,left)={2.5cm}
\SetMargin*(cover,right)={2.5cm}


%%=======================================================================
%% SPINE
%%=======================================================================

\SpineSetup[%
]{%
  box/logo/bg/image           = {Huberlin-logo},
  box/logo/bg/image/angle     = {-90},
  box/title/len   = 18.6cm,
  box/logo/len    =  2.1cm,
  % debug,
}


%%=======================================================================
%% COVER PAGE SETUP (BACKGROUNDS)
%%=======================================================================

\SetThesisCover*(1-1,bgcolor)={white}
\SetThesisCover*(2-1,bgcolor)={white}


%%=======================================================================
%% COVER 1 & 2 ELEMENTS
%%=======================================================================

% Logo
\ntaddtocover[height=2.5cm, valign=t]{1-1,2-1}{%
  \includegraphics[height=2.2cm]{Huberlin-logo}%
}

% University / Faculty / Institute
\ntaddtocover[vspace=5mm]{1-1,2-1}{%
  \color{huberlinblue}%
  \fontseries{b}\fontsize{13}{15}\selectfont%
  \GetUniversity(\@LANG@COVER)\\[1mm]%
  \GetSchool(\@LANG@COVER)\\[1mm]%
  \IfMemVoidF{Department}{\@LANG@COVER}{%
    \GetDepartmentOfString(\@LANG@COVER)\ \GetDepartment(\@LANG@COVER)%
  }%
}

% Title
\ntaddtocover[vspace=1.2cm, halign=l]{1-1,2-1}{%
  \fontseries{b}\fontsize{17}{19}\selectfont%
  \GetDocTitle(\@LANG@COVER,main)%
}

% Doctype + degree line
\ntaddtocover[vspace=1.0cm, halign=l]{1-1,2-1}{%
  \fontsize{12}{14}\selectfont%
  \thepresentationtext%
}

% Author name (+ optional birth line)
\ntaddtocover[vspace=1.2cm, halign=l]{1-1,2-1}{%
  \fontsize{13}{15}\selectfont%
  \GetDocAuthor(name)\\[1mm]%
  \IfMemVoidF{AuthorBirthDate}{}{%
    {\fontsize{10}{12}\selectfont%
     \GetBirthDateLabel(\@LANG@COVER)\ \PrintDateISO{\GetAuthorBirthDate()}%
     \IfMemVoidF{AuthorBirthPlace}{\@LANG@COVER}{%
       \ \GetBirthPlaceLabel(\@LANG@COVER)\ \GetAuthorBirthPlace(\@LANG@COVER)%
     }%
    }%
  }%
}

% Examiners ("1. Gutachter/in    Name", "2. Gutachter/in    Name")
\ntaddtocover[vspace=1.2cm, halign=l]{1-1,2-1}{%
  \fontsize{11}{13}\selectfont%
  \ntprintpersons[name]{0.9}{2}{adviser}{a,c}%
}

% Elastic gap pushes the date to the bottom
\ntaddtocover[vfill=1, halign=l]{1-1,2-1}{%
  \fontsize{12}{14}\selectfont%
  Berlin,~\PrintDateISO{\GetDocDate(submission,year)-\GetDocDate(submission,month)}%
}
