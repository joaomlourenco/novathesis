% All LaTeX engines (pdfLaTeX, XeLaTeX, LuaLaTeX) are accepted
\AddValidProcessor{ulht/mge}{pdf,lua,xe}
\AddValidDegree{ulht/mge}{phd,msc}


%%=======================================================================
%% STRINGS (UNIVERSITY & SCHOOL)
%%=======================================================================

% Faculty / School
\SetSchool*(pt)={Escola de Ciências Econômicas e das Organizações}
\SetSchool*(en)={Escola de Ciências Econômicas e das Organizações}
