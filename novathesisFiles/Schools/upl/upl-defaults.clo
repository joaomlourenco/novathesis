%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% upl/upl-defaults.clo
%% NOVA thesis configuration file
%%
%% Customization for UNIVERSIDADE POLITÉCNICA DE LISBOA (strings and cover)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\typeout{NT FILE upl/upl-defaults.clo}%


% All LaTeX engines (pdfLaTeX, XeLaTeX, LuaLaTeX) are accepted
\AddValidProcessor{upl}{pdf,lua,xe}


% University
\SetUniversity*(pt)={Universidade Politécnica de Lisboa}
\SetUniversity*(en)={Polytechnic University of Lisboa}

\SetSpine(frame,color)={black!50}