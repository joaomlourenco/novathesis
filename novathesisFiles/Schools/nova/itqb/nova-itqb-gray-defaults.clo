\typeout{NT FILE nova/itqb-gray-defaults.clo}%

% All LaTeX engines (pdfLaTeX, XeLaTeX, LuaLaTeX) are accepted
\AddValidProcessor{nova/itqb/gray}{pdf,lua,xe}
\AddValidDegree{nova/itqb/gray}{phd,msc}

% NOVA/ITQB
\NTOptNewChoice{nova/itqb/cover/color}{gray, green}{gray}

% ITQB-NOVA specific customization
\ntsetup{nova/itqb/cover/color=gray}

\input{\DIRSCHOOLS/nova/itqb/nova-itqb-defaults.clo}

