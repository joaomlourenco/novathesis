%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% novathesisFiles/ChapStyles/ist.sty
%% NOVA thesis configuration file
%%
%% Customization for the IST chapter style
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\typeout{NT FILE novathesisFiles/ChapStyles/ist.sty}%


%%=======================================================================
%% PACKAGE REQUIREMENTS
%%=======================================================================

\RequirePackage{soul}


%%=======================================================================
%% SAVEBOXES & COLORS
%%=======================================================================

\definecolor{istchaptercolor}{rgb}{0.7,0.8,0.9}

\@ifundefined{@nt@ist@chapter}{\newsavebox{\@nt@ist@chapter}}{}
\@ifundefined{@nt@ist@part}{\newsavebox{\@nt@ist@part}}{}


%%=======================================================================
%% HELPERS
%%=======================================================================

\providecommand{\@nt@ist@chm}[1][4cm]{%
  \resizebox{!}{#1}{%
    \fboxsep=1pt%
    \color{istchaptercolor}\thechapter%
  }%
}

\providecommand{\@nt@ist@ptm}[1][4cm]{%
  \@nt@ist@chm{#1}
}


%%=======================================================================
%% CHAPTER STYLE
%%=======================================================================

\makechapterstyle{ist}{%
  \renewcommand{\chaptitlefont}{\normalfont\huge\bfseries\sffamily}%
  \renewcommand{\printchaptername}{}%
  \renewcommand{\printchapternum}{%
    % \@nt@ist@chm resizes its content to a FIXED HEIGHT, so embedding
    % "Appendix"/"Annex" inside it would blow up its width along with it
    % (much longer string, same height -> huge width). Print it as its
    % own right-aligned line above the big letter instead.
    \ifx\ntchapnumappendixname\@empty\else
      \null\hfill{\normalfont\bfseries\color{istchaptercolor}\ntchapnumappendixname}\par
    \fi
    \null\hfill\@nt@ist@chm[4cm]\hspace*{14pt}\par}%
  \renewcommand{\afterchapternum}{\vspace*{-11ex}}%
  \renewcommand{\printchaptertitle}[1]{\color{darkgray}\chaptitlefont\raggedleft ##1\par}%
  %
  \renewcommand{\thepart}{\Roman{part}}
  \renewcommand{\printpartnum}{\null\hfill\@nt@ist@ptm[4cm]\hspace*{14pt}\par}%
  \renewcommand{\printparttitle}[1]{\color{darkgray}\parttitlefont\raggedleft ##1\par}%
  \renewcommand*{\partnumfont}{\normalfont\scshape\MakeLowercase}
}

\chapterstyle{ist}
