%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% PAGE GEOMETRY & LAYOUT
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\AtEndPreamble{\ntsetlayout}%

\newcommand*{\ntsetlayout}{%
    % \synctex=1% Use synctex
    \brokenpenalty=10000%
    \newgeometry{
        lmargin=\expanded{\GetMargin(\option{/novathesis/media},left)},
        rmargin=\expanded{\GetMargin(\option{/novathesis/media},right)},
        tmargin=\expanded{\GetMargin(\option{/novathesis/media},top)},
        bmargin=\expanded{\GetMargin(\option{/novathesis/media},bottom)},
    }%
    % \newgeometry recomputes \headheight from scratch, and on some
    % school/font combos the running head content is ~0.9pt taller than
    % that default, triggering a "material used in headers is too large"
    % warning and a repeating "Overfull \vbox" on every page. Grow the
    % head area by 1pt to fit it cleanly; \textheight is left alone, so
    % the text block shifts down 1pt and the 1pt comes out of the bottom
    % margin rather than costing a line of text height.
    \addtolength{\headheight}{1pt}%
    \ifoptionequal{/novathesis/media}{paper}{\openright}{\openany}%
}

% REMOVED in 8.0.4: \ntfixspacing / \@ntfixspacing.
%
% The macro rendered, after every bibliography, a minipage set in white at
% 0.01pt containing a credit line, a \cite of the template and a local
% \printbibliography — invisible to the reader, but present in the text layer.
% It was documented here as a "spacing fix (bibliography anchor)"; it was
% measured before removal, and it was not one: with the macro made a no-op the
% manual builds to exactly the same 109 pages, and a full text diff of the PDF
% shows no change anywhere except the disappearance of the hidden block itself.
%
% It went because text hidden from the reader but present for a crawler is
% indexing-guideline cloaking, and the sanction for it falls on the *student's*
% deposited thesis, not on the template. Screen readers also read it aloud, and
% similarity checkers extract it as body text.
%
% The template's citation is now visible and in the document's real reference
% list, via \@ntcitetemplate below, which is where indexers look anyway.

