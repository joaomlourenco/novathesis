%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Keywords
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\providecommand{\keywords}[1]{%
    \NTRunHook{keywords/pre}%
    % \NTRunHook{keywords/#1/pre}%
    \def\and{\unskip\MemGetDefault{KeywordsSep}[]{\@LSHORT}}%
    % \def\and{{\textperiodcentered} }%
    % Store comma-separated plain-text copy for PDF metadata.
    % \MemSet* is global (prop_gput), so storage survives the \begingroup.
    \begingroup
      \def\and{, }%
      \MemSet*{DocKeywords}{\@LSHORT}{#1}%
    \endgroup
    % Set the PDF info dict Keywords entry here (outside any group) so the
    % expanded string \@nt@pdfkwds is available at macro expansion time.
    %
    % WHY NOT \hypersetup: hyperref writes /Keywords via \PDF@FinishDoc, which
    % runs at the FIRST-PAGE shipout (hook shipout/firstpage). In novathesis the
    % abstract/keywords pages come after the first page, so \hypersetup called
    % here would be silently ignored (the option is disabled by then).
    %
    % Both \pdfextension info (LuaLaTeX) and \pdfinfo (pdfLaTeX) accumulate
    % info-dict entries; the last value for each key wins when the PDF is
    % finalised. Calling here (body time, after the first shipout) correctly
    % overwrites the empty /Keywords entry written by hyperref at first-page
    % shipout. XeLaTeX would need a \special{pdf:info ...} equivalent.
    \IfStrEq{\@LSHORT}{\@LANG@MAIN}{%
      \begingroup
        \def\and{, }%
        \protected@edef\@nt@pdfkwds{\MemGet{DocKeywords}{\@LANG@MAIN}}%
        \ifluatex
          \pdfextension info{/Keywords(\@nt@pdfkwds)}%
        \else\ifpdftex
          \pdfinfo{/Keywords(\@nt@pdfkwds)}%
        \fi\fi
      \endgroup
    }{}%
    \par\addvspace\baselineskip\noindent%
    \begingroup%
    \MemGetDefault{KeywordsStringPrefix}[]{\@LSHORT}%
    \MemGetDefault{KeywordsStringFont}[]{\@LSHORT}%
    \GetKeywordsString(\@LSHORT)%
    \MemGetDefault{KeywordsStringSuffix}[]{\@LSHORT}%
    \endgroup%
    % \enspace
    \ignorespaces#1%
    % \NTRunHook{keywords/#1/post}%
    \NTRunHook{keywords/post}%
}%



