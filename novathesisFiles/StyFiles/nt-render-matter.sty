%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Print Sustainable Development Goals (SDG)
%% To be called from \ntprintabstracts
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Row breaking is left to TeX.  The icons are ordinary boxes separated by
% \hspace glue, so the paragraph builder wraps them across as many rows as
% needed, for any icon width, page width or margin setting.
%
% Row separation is controlled through \lineskip rather than an explicit
% "\\[<vspace>]": because every icon box is far taller than the prevailing
% \baselineskip, TeX always falls back to \lineskip between these rows, so
% setting it *is* the vertical gap (this holds under \OnehalfSpacing too).
%
% A previous version tried to break rows by hand, accumulating a running width
% in a \sdgdim register and emitting "\\[<vspace>]" when it overflowed
% \textwidth.  That register was never actually accumulated, so the test read
% "is ONE icon wider than the whole text block?" and could never be true: the
% manual break never fired, and with it the print/sdgs/vspace option silently
% did nothing.  Rows still came out correctly, but only because TeX had been
% doing the wrapping all along.
\newcommand*{\ntprintsdgs}{%
  \ifoptionnil{/novathesis/print/sdgs/list}{}{%
      \vfill%
      \raggedright\noindent%
      % Fall back to the English SDG heading when the abstract language does
      % not define one (e.g. zhs/zht, whose string files are minimal), so that
      % SDGs + a Chinese abstract do not raise a memstore "unknown key" error.
      \textbf{\IfMemVoidTF{SdgString}{\@LSHORT}
                {\GetSdgString(en)}%
                {\GetSdgString(\@LSHORT)}:}\\[1ex]
      \edef\@sdgtype{\option{/novathesis/print/sdgs/type}}
      \ntchecksdgs{\@LSHORT}{\@sdgtype}%
      \IfFileExists{\DIRIMAGES/sdg-\@LSHORT/1-\@sdgtype.pdf}
          {\def\@spnfolder{\DIRIMAGES/sdg-\@LSHORT}}
          {\def\@spnfolder{\DIRIMAGES/sdg-en}}
      \begingroup
        \lineskip=\option{/novathesis/print/sdgs/vspace}\relax
        \noindent
        \optionlistdo{/novathesis/print/sdgs/list}{%
          \includegraphics[width=\option{/novathesis/print/sdgs/size}]
                          {\@spnfolder/##1-\@sdgtype}%
          \hspace{\option{/novathesis/print/sdgs/hspace}}%
        }%
        \par
      \endgroup
  }%
}


