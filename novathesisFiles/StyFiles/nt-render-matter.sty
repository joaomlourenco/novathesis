        {\IfFontExistsTF{Noto~Sans~CJK~SC}
          {\newfontfamily\nt@cjkfontSC{Noto~Sans~CJK~SC}}
          {\IfFontExistsTF{Heiti~SC}
            {\newfontfamily\nt@cjkfontSC{Heiti~SC}}
            {\newfontfamily\nt@cjkfontSC{Latin~Modern~Roman}}%
