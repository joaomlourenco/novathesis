\newenvironment{tightcenter}
  {\par\centering}
  {\par}%

\NewDocumentCommand { \TheCandidateSignature } { m m }
  % #1 = place
  % #2 = ISO DATE
  {
    \begin{center}%
      \StatementOneSignature%
        {\expandafter\GetCandidateString\expandafter(\GetDocAuthor(gender),\@LANG@MAIN)}
        {\GetDocAuthor(name)}%
        {#1}% place
        {#2}% date
    \end{center}%
  }
% Deprecated misspelled alias, kept for backwards compatibility.
\NewCommandCopy\TheCandiadteSignature\TheCandidateSignature


\newcounter{nadv}
% \ntforeachperson callback for \TheAdvisersSignatures, curried with
% (space,role,place,date); title/position/institution are ignored, only
% the name and gender feed the signature line.
\newcommand{\@nt@advisersignature}[9]{%
  % #1=space #2=role #3=place #4=date (curried)
  % #5=title #6=name #7=position #8=institution #9=gender
  \stepcounter{nadv}
  \StatementOneSignature[#1]
    {\GetAdviserString(pref,#2,1,#9,\@LANG@MAIN)}
    {#6}
    {#3}% place
    {#4}% date
}
\NewDocumentCommand { \TheAdvisersSignatures } { O{20mm} m m m }
  % #1 = space to signature rule
  % #2 = a (only advisers) | a,c (both advisers and co-advisers)
  % #3 = place
  % #4 = ISO DATE
  {
    \begin{tightcenter}
      \ifnum\ntpersoncount{adviser}{#2}>0\relax%
        \ntforeachperson{adviser}{#2}{\@nt@advisersignature{#1}{#2}{#3}{#4}}%
      \fi%
    \end{tightcenter}
  }


\NewDocumentCommand { \StatementOneSignature } { O{20mm} m m m m }
  % #1 = space to rule
  % #2 = text above
  % #3 = name
  % #4 = place
  % #5 = date
  {
    \begin{minipage}[t]{6cm}
      \medskip%
      \begin{center}
        #2,\par
        \vspace*{#1}
        \rule{\linewidth}{0.75pt}\par
        \textit{#3}\\
        \ifblank{#4}{}{#4,~}\PrintDateISO{#5}
      \end{center}
    \end{minipage}
  }



%% Default list-of bookmark level (1 = direct child of Front/Back Matter group).
%% \ntprintalllistof overrides this to 2 when a "List of..." group header is present.
\def\@nt@lol@bkm@level{1}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Deal with optional lists in the frontmatter: listoftables, litoffigures, etc.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcommand*{\ntprintalllistof}{%
    \NTRunHook{listof/pre}%
    \if@backmatter
      \def\@matter{backmatter}
    \else
      \def\@matter{frontmatter}
      \iftoggle{/novathesis/tocintoc}
            {\begingroup
               % \tableofcontents (non-starred) creates a \chapter* bookmark that
               % would be shifted by any active \shiftbookmarks.  Temporarily reset
               % toclevel@chapter to 0 so Contents always appears at the root level.
               \expandafter\def\csname toclevel@chapter\endcsname{0}%
               \tableofcontents
             \endgroup}%
            {\bookmark[level=0, dest=\HyperLocalCurrentHref]{\contentsname}
             \tableofcontents*}%
    \fi
    \@nt@listof@ifdefined{\@matter}{
      \edef\@nt@listof@bkmtitle{\GetBkmString(listof,\@LANG@MAIN)}%
      \clearforchapter%
      \phantomsection%
      \bookmark[level=0, dest=\HyperLocalCurrentHref]{\@nt@listof@bkmtitle}%
      \@nt@listof@run{\@matter}{##1}%
    }{}%
    \NTRunHook{listof/post}%
}


