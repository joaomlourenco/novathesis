%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Colophon
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% A labelled Colophon page in the back matter: the traditional
% book-design place for production details (typesetting engine,
% template, PDF/A status, build date). Prints at every docstatus,
% including working, since it is now the template's only credit line --
% the old copyright-page mini-colophon (\SetAcknowledgmentsString) was
% removed rather than left to duplicate this page (see its own comment
% for schools that still want that block for their own purposes).
%
% Fully multilingual: \GetBkmString(colophon,...) for the page title
% and \GetColophonString / \GetColophonPdfaString /
% \GetColophonNotPdfaString / \GetColophonBuildString (all defined per
% language in novathesisFiles/Strings/strings-*.ldf) for the body, same
% as every other template-generated string, keyed by \@LANG@MAIN. No
% zhs/zht fallback needed: lang/main is a choice restricted to the same
% 14 languages these strings cover, so \@LANG@MAIN can never be zhs/zht
% (those exist only for abstract translations, via a separate mechanism).
%
% Opt out with \ntsetup{print/colophon=false}.
%
% Fixed constant, reused verbatim from the hidden white-text credit this
% colophon replaces (see the "REMOVED in 8.0.4" note near the top of this
% file) -- not a hash of anything computed at build time.
\def\@nt@colophonbuildid{12cc9022}

% Curated display name(s) for the FontStyles/*.sty style currently loaded
% by \ntsetup{style/font=...}. Each FontStyles file registers its own
% name(s) locally, right where it calls \setmainfont/\setromanfont (main),
% \setsansfont (sans), \setmonofont (mono/tt) and \setmathfont or a math
% package (math) -- see any file under novathesisFiles/FontStyles/ for the
% pattern; a font file that doesn't set a given role (e.g. no separate
% math font) simply doesn't touch that macro, and it stays empty.
%
% \FontPrettyName (main) is the only mandatory one: the safety-net
% \IfStrEq check below the font-loading code falls back to the raw
% style/font value itself if it is still empty after loading, so an
% unrecognised/custom school font never breaks the build -- it just
% prints plainly. The sans/mono/math variants are optional and stay
% empty when not set; consumers must check for blankness before use.
\newcommand*{\FontPrettyName}{}
\newcommand*{\FontPrettyNameSans}{}
\newcommand*{\FontPrettyNameMono}{}
\newcommand*{\FontPrettyNameMath}{}

% Optional colophon detail, appended right after \FontPrettyName -- which
% no longer carries its own trailing period (see \SetColophonString in
% strings-*.ldf): this macro supplies the sentence's final "." either way,
% so the colophon always ends in exactly one, never a dangling
% "). (sans: ...)" fragment tacked on after it.
%
% Folds whichever of \FontPrettyNameSans/Mono/Math the loaded font file
% set into ", with A for sans, B for mono and C for math." -- properly
% comma/"and"-joined (2 items use just "and", 3+ use a comma-separated
% list with "and" before the last) via \FormatNamesAsList
% (nt-render-persons.sty), the same joiner already used for adviser/
% committee name lists, so the "and" is pulled from \GetAndString and is
% already correctly localized in all 14 languages. Prints just "." when
% none of the three were set.
%
% The "with .. for sans/mono/math" glue words themselves are deliberately
% left in English across all languages, same as the "sans"/"mono"/"math"
% labels they attach to (see \FontPrettyNameSans and friends above): they
% are typographic jargon, not document prose, and translating a sentence
% frame (as opposed to the single "and" word \FormatNamesAsList already
% localizes for us) was judged out of proportion to what was asked.
\newcommand*{\@nt@colophonfontdetails}{%
  \begingroup
    \def\@nt@cfd@list{}%
    \def\@nt@cfd@sep{}%
    \IfStrEq{\FontPrettyNameSans}{}{}{%
      \edef\@nt@cfd@list{\@nt@cfd@list\@nt@cfd@sep\FontPrettyNameSans{} for sans}%
      \def\@nt@cfd@sep{,}%
    }%
    \IfStrEq{\FontPrettyNameMono}{}{}{%
      \edef\@nt@cfd@list{\@nt@cfd@list\@nt@cfd@sep\FontPrettyNameMono{} for mono}%
      \def\@nt@cfd@sep{,}%
    }%
    \IfStrEq{\FontPrettyNameMath}{}{}{%
      \edef\@nt@cfd@list{\@nt@cfd@list\@nt@cfd@sep\FontPrettyNameMath{} for math}%
    }%
    \IfStrEq{\@nt@cfd@list}{}{.}{,~with~\FormatNamesAsList{\@nt@cfd@list}.}%
  \endgroup
}

\newcommand*{\ntprintcolophon}{%
  \ifmaindoc{%
    \iftoggle{/novathesis/print/colophon}{%
      \chapter*{\GetBkmString(colophon,\@LANG@MAIN)}%
      \NTRunHook{colophon/pre}%
      \begin{center}
        \IfFileExists{\DIRIMAGES/novathesis-insignia-outline.pdf}
          {\includegraphics[width=12mm]{\DIRIMAGES/novathesis-insignia-outline}}
          {}%
      \end{center}
      \bigskip
      \noindent
      \GetColophonString(\@LANG@MAIN)%
      \@nt@colophonfontdetails%
      \par\bigskip
        \fullcite{novathesis-manual}%
      \ifdocfinal{%
        \iftoggle{/novathesis/pdfa}%
          {\GetColophonPdfaString(\@LANG@MAIN)}%
          {\GetColophonNotPdfaString(\@LANG@MAIN)}%
      }{%
        \GetColophonNotPdfaString(\@LANG@MAIN)%
      }%
      \par\bigskip
      {\scriptsize \GetColophonBuildString(\@LANG@MAIN)}%
      \NTRunHook{colophon/post}%
    }{}%
  }{}%
}


