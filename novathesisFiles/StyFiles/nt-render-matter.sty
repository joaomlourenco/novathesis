\newcommand*{\@nt@glssrc}{}

% Add one registered source to the accumulator, refusing 7.10-era .tex files
% with a message that says exactly what to do about it.
\newcommand*{\@nt@glsaddsrc}[1]{%
  \IfFileExists{#1.bib}
    {}
    {\IfFileExists{#1.tex}
       {\ClassError{novathesis}
          {Glossary source '#1.tex' is in the old (7.10.x) format}
          {novathesis 8.0 keeps glossary entries in .bib files, read by
           bib2gls, instead of .tex files read by makeglossaries.^^J
           Run 'make glsbib' to convert your entry files, then CHECK THE SORT
           KEYS: the converter silently drops them, which reorders any entry
           whose name is a macro or math markup.^^J
           See the migration appendix of the manual for the full procedure.}}
       {\ClassError{novathesis}
          {Glossary source '#1.bib' not found}
          {\ntaddfile{glossaries} registered '#1', but neither '#1.bib' nor
           '#1.tex' exists. Check the file name in 0-Config/4_files.tex.}}%
    }%
  \ifdefempty{\@nt@glssrc}
    {\xdef\@nt@glssrc{#1}}
    {\xdef\@nt@glssrc{\@nt@glssrc,#1}}%
}

% Emit one \GlsXtrLoadResources for the given glossary types, if any file was
% registered for them.  #1=comma list of types, #2=bib2gls selection.
\newcommand*{\@nt@glsresource}[2]{%
  \gdef\@nt@glssrc{}%
  \@for\nt@glstype:=#1\do{%
    \iffileadded[\nt@glstype]{glossaries}
      {\@nt@foralllist{file}{glossaries/\nt@glstype}{\@nt@glsaddsrc}}
      {}%
  }%
  \ifdefempty{\@nt@glssrc}{}{%
    \GlsXtrLoadResources[
      src={\@nt@glssrc},
      selection={#2},
      loc-prefix={\ntglslocprefixone,\ntglslocprefixmany},
    ]%
  }%
}

\newcommand*{\@loadglossaryfiles}{%
  % main + symbols reproduce what \glsaddall[types={main,symbols}] used to do:
  % every entry is listed whether or not it is cited.  Abbreviations stay
  % use-based, so unused acronyms do not pad the list.
  \@nt@glsresource{glossary,symbols}{all}%
  \@nt@glsresource{acronym}{recorded and deps}%
}


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% BIBLIOGRAPHY & INDEXING
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Add the template's own reference to the document's bibliography.
%
% The entry must land in refsection 0 — the document's *main* reference list —
% because that is the only place that counts: bibliographic indexers (Google
% Scholar among them) count a citation by parsing the reference list of the
% citing document, so a reference confined to a local \refsection, or merely
% printed as a formatted string elsewhere, is invisible to them.
%
% It is issued here, immediately before \printbibliography, rather than from
% \AfterPreamble: at \begin{document} biblatex has not yet read the .bbl, so an
% earlier \nocite raises a spurious "Citation 'novathesis-manual' undefined"
% warning on every single build.
%
% Opt out with \ntsetup{cite/template=false}.
\newcommand*{\@ntcitetemplate}{%
  \nocite{novathesis-manual}%
}

% Tell the author, once per build, that the reference was added and how to
% remove it.  Silent when the option is off (the choice was already made, and
% nagging about it would be rude) and when docstatus=final, so that the build
% of the document actually being submitted carries no chatter.
%
% Every line is prefixed with "[novathesis]" because the Makefile filters the
% engine output through texfot, which discards ordinary \typeout lines; that
% prefix is the pattern texfot is told to --accept, and it is used for nothing
% else.  Without it this message would exist only in the .log, where nobody
% would read it.
\AtEndDocument{%
  \ifdocfinal{}{%
    \iftoggle{/novathesis/cite/template}{%
      \typeout{^^J%
[novathesis] ---------------------------------------------------------^^J%
[novathesis] The reference to the template (v\novathesisversion) was added to your^^J%
[novathesis] bibliography.  novathesis is free, and citations are the only^^J%
[novathesis] currency in which the work is repaid -- please consider^^J%
[novathesis] keeping it.  DOI: 10.5281/zenodo.21938603^^J%
[novathesis]^^J%
[novathesis] ---------------------------------------------------------^^J%
      }%
    }{}%
  }%
}

\newcommand*{\ntprintbibsingle}[1][]{%
  \NTRunHook{printbib/pre}%
  \@ntcitetemplate%
  \printbibliography[#1]%
  \NTRunHook{printbib/post}%
}

\newcommand*{\ntprintbibseparate}[1][]{%
  \NTRunHook{printbib/pre}%
    \@ntcitetemplate%
    \printbibliography[nottype=online]% Print the main bibliography.
    % Print the web references separately, under their own title.
    \printbibliography[title=\option{/novathesis/print/webography},type=online]%
  \NTRunHook{printbib/post}%
}


