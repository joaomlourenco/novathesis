% Font names below use "~" instead of literal spaces: under ExplSyntaxOn,
% space (catcode 9) is ignored, but "~" is catcode 10 (an ordinary
% interword space), so multi-word font names survive untouched. This is
% safe here because IfFontExistsTF/newfontfamily only query the OS font
% backend with a string -- unlike \InputIfFileExists/\input/\RequirePackage
% elsewhere in this file, nothing here reads and tokenizes an external
% file's contents under these catcodes.
\ExplSyntaxOn
\IfSubStr{,\@LANG@LOADED,}{,zhs,}{%
  \iftutex
    \ifcsname nt@cjkfontSC\endcsname\else
      \IfFontExistsTF{PingFang~SC}
