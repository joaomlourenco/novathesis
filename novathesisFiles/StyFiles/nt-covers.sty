% Variables for cover management
\seq_new:N \g_nt_covers_ids_seq
\seq_set_from_clist:Nn \g_nt_covers_ids_seq { 1-1, 1-2, 2-1, 2-2, N-1, N-2 }

% Props to store content (cover_id => seq of { {attrs}{code} })
\prop_new:N \g_nt_covers_content_prop
\prop_new:N \g_nt_covers_tikz_prop

% Variables for current rendering context
\dim_new:N \l_nt_covers_top_dim
\dim_new:N \l_nt_covers_bottom_dim
\dim_new:N \l_nt_covers_left_dim
\dim_new:N \l_nt_covers_right_dim
\dim_new:N \l_nt_covers_width_dim
\dim_new:N \l_nt_covers_height_dim
\tl_new:N  \l_nt_covers_debuggrid_color_tl
% Text-area edges, rounded outward to a whole mm (left/top down, right/bottom
% up) so the fine 1mm grid -- which shares its origin with the coarse grid's
% own (current page.north west) reference, per \debuggrid below -- always
% lands exactly on a step and starts with a line, instead of sitting mid-cell
% when a margin (e.g. 18.55mm) isn't already a round mm value.
\dim_new:N \l_nt_covers_debuggrid_left_dim
\dim_new:N \l_nt_covers_debuggrid_top_dim
\dim_new:N \l_nt_covers_debuggrid_right_dim
\dim_new:N \l_nt_covers_debuggrid_bottom_dim
\tl_new:N  \l_nt_covers_tmp_tl
\tl_new:N  \l_nt_covers_content_tl
\tl_new:N  \g_nt_covers_tikz_overlay_tl
\tl_new:N  \l_nt_covers_doctype_tl
\tl_new:N  \l_nt_covers_docstatus_tl
\tl_new:N  \l_nt_covers_textcolor_tl
\tl_new:N  \l_nt_covers_textfont_tl
\clist_new:N \l_nt_covers_elem_status_clist
\clist_new:N \l_nt_covers_elem_degree_clist
\tl_new:N  \l_nt_covers_elem_halign_tl
\tl_new:N  \l_nt_covers_elem_valign_tl
\tl_new:N  \l_nt_covers_elem_vspace_tl
\tl_new:N  \l_nt_covers_elem_vfill_tl
\dim_new:N \l_nt_covers_elem_hspace_dim
\dim_new:N \l_nt_covers_elem_height_dim
\dim_new:N \l_nt_covers_elem_minheight_dim
\dim_new:N \l_nt_covers_elem_width_dim
\dim_new:N \l_nt_covers_body_dim   % computed width of the element body
\dim_new:N \l_nt_covers_pad_dim    % padding added to satisfy 'minheight'
\tl_new:N  \l_nt_covers_elem_color_tl
\tl_new:N  \l_nt_covers_elem_bgcolor_tl
\bool_new:N \l_nt_covers_elem_tikz_bool
\bool_new:N \l_nt_covers_elem_newpar_bool
\bool_new:N \l_nt_covers_status_match_bool
\bool_new:N \l_nt_covers_degree_match_bool
\bool_new:N \l_nt_covers_defined_bool

% Attributes for individual elements
% NOTE: The 'degree' option accepts comma-separated values in braces, e.g.:
%       degree={phd,phdprop,phdplan}  - element renders only if @DOCTYPE matches one of these
% Syntax: degree={item1,item2,...}
% - Braces MUST be used around comma-separated lists (required by LaTeX keys system)
% - The degree filter checks if @DOCTYPE (e.g., 'phd', 'msc') matches any value
% - Element is only rendered if degree filter matches or is empty
% - When degree is empty, element renders for all doctypes
\keys_define:nn { nt/covers/element }
  {
    status    .clist_set:N = \l_nt_covers_elem_status_clist,
    degree    .code:n = {
      % Degree filtering: element renders only if @DOCTYPE matches one of these values
      % Input must be braced and comma-separated, e.g.: {phd,phdprop,phdplan}
      % The braces protect commas from being interpreted as key separators by the keys system
      \clist_set:Nn \l_nt_covers_elem_degree_clist { #1 }
    },
    halign    .choices:nn = { l, c, r, j }
                { \tl_set:Nn \l_nt_covers_elem_halign_tl { #1 } },
    valign    .choices:nn = { t, c, b }
                { \tl_set:Nn \l_nt_covers_elem_valign_tl { #1 } },
    vspace    .tl_set:N    = \l_nt_covers_elem_vspace_tl,
    vfill     .tl_set:N    = \l_nt_covers_elem_vfill_tl,
    hspace    .dim_set:N   = \l_nt_covers_elem_hspace_dim,
    height    .dim_set:N   = \l_nt_covers_elem_height_dim,
    minheight .dim_set:N   = \l_nt_covers_elem_minheight_dim,
    width     .dim_set:N   = \l_nt_covers_elem_width_dim,
    color     .tl_set:N    = \l_nt_covers_elem_color_tl,
    bgcolor   .tl_set:N    = \l_nt_covers_elem_bgcolor_tl,
    tikz      .bool_set:N  = \l_nt_covers_elem_tikz_bool,
    newpar    .bool_set:N  = \l_nt_covers_elem_newpar_bool,
    % NOTE: no '.initial:n' defaults are declared here.  They would apply only
    % once, at key-definition time, whereas every element must start from a
    % clean state: \keys_set:nn is called once per element and unset keys keep
    % whatever the previous element left behind.  The per-element defaults are
    % therefore applied by \nt_covers_elem_reset_defaults: (below), which runs
    % immediately before each \keys_set:nn.  That helper is the single source
    % of truth for element defaults -- change values there, not here.
  }

% Map for alignment macros
\prop_new:N \g_nt_covers_align_map_prop
\prop_gput:Nnn \g_nt_covers_align_map_prop { c } { \centering }
\prop_gput:Nnn \g_nt_covers_align_map_prop { l } { \raggedright }
\prop_gput:Nnn \g_nt_covers_align_map_prop { r } { \raggedleft }
\prop_gput:Nnn \g_nt_covers_align_map_prop { j } { \null }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% INTERNAL HELPERS
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\cs_new_protected:Nn \nt_covers_reset_one:n
  {
    \prop_gremove:Nn \g_nt_covers_content_prop { #1 }
    \prop_gremove:Nn \g_nt_covers_tikz_prop { #1 }
  }

\cs_new_protected:Nn \nt_covers_add_to_prop:nnn
  {
    \prop_get:NnNTF #1 { #2 } \l_nt_covers_content_tl
      {
        \tl_put_right:Nn \l_nt_covers_content_tl { #3 }
        \prop_gput:NnV #1 { #2 } \l_nt_covers_content_tl
      }
      { \prop_gput:Nnn #1 { #2 } { #3 } }
  }

% Per-element defaults.  SINGLE SOURCE OF TRUTH: this runs immediately before
% every \keys_set:nn for { nt/covers/element }, so a key the caller omits falls
% back to the value set here rather than leaking in from the previous element.
% (This is why the key definitions carry no '.initial:n' -- see the note there.)
\cs_new_protected:Nn \nt_covers_elem_reset_defaults:
  {
    \clist_clear:N \l_nt_covers_elem_status_clist       % status    = {}
    \clist_clear:N \l_nt_covers_elem_degree_clist       % degree    = {}
    \tl_set:Nn \l_nt_covers_elem_halign_tl { c }        % halign    = c
    \tl_set:Nn \l_nt_covers_elem_valign_tl { c }        % valign    = c
    \tl_set:Nn \l_nt_covers_elem_vspace_tl { 0pt }      % vspace    = 0pt
    \tl_clear:N \l_nt_covers_elem_vfill_tl              % vfill     = {}
    \dim_set:Nn \l_nt_covers_elem_hspace_dim { 0pt }    % hspace    = 0pt
    \dim_set:Nn \l_nt_covers_elem_height_dim { 0pt }    % height    = 0pt (natural)
    \dim_set:Nn \l_nt_covers_elem_minheight_dim { 0pt } % minheight = 0pt (disabled)
    \dim_set:Nn \l_nt_covers_elem_width_dim { 0pt }     % width     = 0pt (full width)
    \tl_clear:N \l_nt_covers_elem_color_tl              % color     = {} (inherit)
    \tl_clear:N \l_nt_covers_elem_bgcolor_tl            % bgcolor   = {} (none)
    \bool_set_false:N \l_nt_covers_elem_tikz_bool       % tikz      = false
    \bool_set_true:N \l_nt_covers_elem_newpar_bool      % newpar    = true
  }

% Check if element matches current doc status and degree
% Args: #1 = element attributes (status, degree, etc.)
% Returns: true if element should be rendered, false otherwise
%
% Matching logic:
%   - status: if specified, @DOCSTATUS must be in list (or empty list means match all)
%   - degree: if specified, @DOCTYPE must be in list (or empty list means match all)
% Both conditions must be true for element to be rendered.
\prg_new_protected_conditional:Npnn \nt_covers_if_match:n #1 { T, F, TF }
  {
    % Reset all element variables to defaults before parsing new attributes
    \nt_covers_elem_reset_defaults:

    \keys_set:nn { nt/covers/element } { #1 }
    \bool_set_true:N \l_nt_covers_status_match_bool % status match
    \bool_set_true:N \l_nt_covers_degree_match_bool % degree match

    % Expand @DOCTYPE and @DOCSTATUS macros into expl3 variables for proper matching
    \tl_set:Nx \l_nt_covers_doctype_tl { \@DOCTYPE }
    \tl_set:Nx \l_nt_covers_docstatus_tl { \@DOCSTATUS }

    % Check status if specified
     \clist_if_empty:NF \l_nt_covers_elem_status_clist
       {
         \clist_if_in:NVF
           \l_nt_covers_elem_status_clist
           \l_nt_covers_docstatus_tl
           { \bool_set_false:N \l_nt_covers_status_match_bool }
       }

    % Check degree if specified
    % @DOCTYPE is set to the document degree type (e.g., 'phd', 'msc', 'phd_prop', etc.)
    % Element is only rendered if @DOCTYPE appears in the degree list, or degree is empty.
    \clist_if_empty:NF \l_nt_covers_elem_degree_clist
      {
        \clist_if_in:NVF
          \l_nt_covers_elem_degree_clist
          \l_nt_covers_doctype_tl
          { \bool_set_false:N \l_nt_covers_degree_match_bool }
      }

    \bool_if:nTF
      {
        \l_nt_covers_status_match_bool
        && \l_nt_covers_degree_match_bool
      }
      { \prg_return_true: }
      { \prg_return_false: }
  }

\cs_new_protected:Nn \nt_covers_apply_vspace:n
  {
    \tl_if_empty:NTF \l_nt_covers_elem_vfill_tl
      { \vspace* { #1 } }
      { \vskip 0pt plus \l_nt_covers_elem_vfill_tl fill }
  }
\cs_generate_variant:Nn \nt_covers_apply_vspace:n { V }

% Box for element rendering
\box_new:N \l_nt_covers_elem_box

% Enforce the 'minheight' attribute on an already-typeset element box.
% The body is typeset only ONCE: rather than re-running the content to fit a
% taller minipage (which would repeat any side effects it has, e.g. counters
% or \label), the shortfall is added to the box's own height/depth.  TeX then
% reserves that space when the box is contributed to the enclosing vertical
% list, so the element occupies at least 'minheight'.  Where the padding goes
% follows valign: t = all below, b = all above, c (default) = split evenly.
% A box already at least 'minheight' tall is left untouched.
\cs_new_protected:Nn \nt_covers_apply_minheight:N
  {
    \dim_compare:nNnT { \l_nt_covers_elem_minheight_dim } > { 0pt }
      {
        \dim_set:Nn \l_nt_covers_pad_dim
          {
            \l_nt_covers_elem_minheight_dim
            - \box_ht:N #1 - \box_dp:N #1
          }
        \dim_compare:nNnT { \l_nt_covers_pad_dim } > { 0pt }
          {
            \str_case:VnF \l_nt_covers_elem_valign_tl
              {
                { t }
                  { \box_set_dp:Nn #1 { \box_dp:N #1 + \l_nt_covers_pad_dim } }
                { b }
                  { \box_set_ht:Nn #1 { \box_ht:N #1 + \l_nt_covers_pad_dim } }
              }
              {
                \box_set_ht:Nn #1 { \box_ht:N #1 + 0.5 \l_nt_covers_pad_dim }
                \box_set_dp:Nn #1 { \box_dp:N #1 + 0.5 \l_nt_covers_pad_dim }
              }
          }
      }
  }

\cs_new_protected:Nn \nt_covers_render_element:nn
  {
    \nt_covers_if_match:nTF { #1 }
      {
        \bool_if:NTF \l_nt_covers_elem_tikz_bool
          { \tl_gput_right:Nn \g_nt_covers_tikz_overlay_tl { #2 } }
          {
            % 1. Apply Vertical Space
            \nt_covers_apply_vspace:V \l_nt_covers_elem_vspace_tl

            % 2. Compute element width
            \group_begin:
              \noindent \hspace* { \l_nt_covers_elem_hspace_dim }

              \dim_compare:nNnTF { \l_nt_covers_elem_width_dim } > { 0pt }
                { \dim_set_eq:NN \l_nt_covers_body_dim \l_nt_covers_elem_width_dim }
                {
                  \dim_set:Nn \l_nt_covers_body_dim
                    {
                      \l_nt_covers_width_dim
                      - \l_nt_covers_elem_hspace_dim
                    }
                }

              % 3. Typeset the element body once into a box, so that
              %    'minheight' can be enforced (and a bgcolor wrapped around
              %    the result) without ever re-running the content.
              \hbox_set:Nw \l_nt_covers_elem_box
                \dim_compare:nNnTF
                  { \l_nt_covers_elem_height_dim } > { 0pt }
                  {
                    \begin { minipage }
                      [ \l_nt_covers_elem_valign_tl ]
                      [ \dim_use:N \l_nt_covers_elem_height_dim ]
                      { \l_nt_covers_body_dim }
                  }
                  {
                    \begin { minipage }
                      [ \l_nt_covers_elem_valign_tl ]
                      { \l_nt_covers_body_dim }
                  }
                \tl_if_empty:NF \l_nt_covers_elem_color_tl
                  { \color { \l_nt_covers_elem_color_tl } }
                \prop_get:NVN
                  \g_nt_covers_align_map_prop
                  \l_nt_covers_elem_halign_tl
                  \l_nt_covers_tmp_tl
                \l_nt_covers_tmp_tl
                #2
                \end { minipage }
              \hbox_set_end:

              % 4. Enforce 'minheight' before any bgcolor is applied, so the
              %    background covers the padded area too.
              \nt_covers_apply_minheight:N \l_nt_covers_elem_box

              % 5. Emit, colorbox-wrapped when a bgcolor was requested.
              \tl_if_empty:NF \l_nt_covers_elem_bgcolor_tl
                {
                  \hbox_set:Nn \l_nt_covers_elem_box
                    {
                      \colorbox
                        { \l_nt_covers_elem_bgcolor_tl }
                        { \box_use:N \l_nt_covers_elem_box }
                    }
                }
              \box_use:N \l_nt_covers_elem_box

              \bool_if:NT \l_nt_covers_elem_newpar_bool { \par }
            \group_end:
          }
      }
      { }
  }

\cs_new_protected:Nn \nt_covers_print_text:n
  {
    % Fetch Margins from Memory (mimicking original logic with full hierarchy)
    \clist_map_inline:nn { top, bottom, left, right }
      {
        % Canonical hierarchy: cover-specific tier first, then global tier
        \datamatch { \l_nt_covers_tmp_tl } { Margin } (
          \nthierkeys { cover, } { #1,##1 } ,
          \nthierkeys { cover, } { ##1 }
        )
        \dim_set:cn { l_nt_covers_ ##1 _dim } { \l_nt_covers_tmp_tl }
      }

    \dim_set:Nn \l_nt_covers_width_dim
      {
        \paperwidth - \l_nt_covers_left_dim - \l_nt_covers_right_dim
      }
    \dim_set:Nn \l_nt_covers_height_dim
      {
        \paperheight - \l_nt_covers_top_dim - \l_nt_covers_bottom_dim
      }

    % Lookup text color for this cover (default: black)
    % Applied as the first command inside the minipage so all elements inherit it.
    \tl_set:Nn \l_nt_covers_textcolor_tl { black }
    \datamatchtf { \l_nt_covers_textcolor_tl } { ThesisCover } (
      \nthierkeys { } { #1,textcolor } ,
      \nthierkeys { } { textcolor }
    ) { } { }
    % Guard against an empty match (e.g. school sets textcolor to nothing)
    \tl_if_empty:NT \l_nt_covers_textcolor_tl
      { \tl_set:Nn \l_nt_covers_textcolor_tl { black } }

    % Lookup text font for this cover (default: empty = no font switch)
    % NOTE: must NOT use \datamatchtf — it e-expands stored values, which corrupts
    % command tokens like \sffamily.  Use \prop_get:cnN directly (no expansion).
    \tl_clear:N \l_nt_covers_textfont_tl
    \exp_args:Ne \clist_map_inline:nn
      {
        \nthierkeys { } { #1,textfont } ,
        \nthierkeys { } { textfont }
      }
      {
        \prop_get:cnNTF
          { g__mem_ThesisCover_prop }
          { ##1 }
          \l_nt_covers_textfont_tl
          { \clist_map_break: }
          { }
      }

    \tl_gclear:N \g_nt_covers_tikz_overlay_tl

    \begin { tikzpicture } [ remember~picture, overlay ]
      \node
        [ anchor = north~west, inner~sep = 0,
          xshift = \dim_use:N \l_nt_covers_left_dim,
          yshift = - \dim_use:N \l_nt_covers_top_dim ]
        at ( current~page.north~west )
        {
          \begin { minipage }
            [ t ]
            [ \dim_use:N \l_nt_covers_height_dim ]
            [ t ]
            { \dim_use:N \l_nt_covers_width_dim }
            % Step 3: set default text colour and font (inherited by all elements in this minipage)
            \color { \l_nt_covers_textcolor_tl }
            \tl_if_empty:NF \l_nt_covers_textfont_tl
              { \tl_use:N \l_nt_covers_textfont_tl }
            \NTRunHook { cover/text/pre }
            \NTRunHook { cover/#1/text/pre }
            \prop_get:NnNTF
              \g_nt_covers_content_prop
              { #1 }
              \l_nt_covers_content_tl
              {
                \tl_map_inline:Nn
                  \l_nt_covers_content_tl
                  { \nt_covers_render_element:nn ##1 }
              }
              { }
            \NTRunHook { cover/#1/text/post }
            \NTRunHook { cover/text/post }
          \end { minipage }
        } ;
    \end { tikzpicture }
    % Execute TikZ overlay OUTSIDE the primary picture to avoid nullfont issues with leading spaces
    \tl_if_empty:NF \g_nt_covers_tikz_overlay_tl
      {
        \begin { tikzpicture } [ remember~picture, overlay ]
          % Re-apply the cover textcolor so overlay nodes inherit it (the minipage
          % group already closed, reverting \color back to the document default)
          \color { \l_nt_covers_textcolor_tl }
          \g_nt_covers_tikz_overlay_tl
        \end { tikzpicture }
      }
  }

\cs_new_protected:Nn \nt_covers_print_tikz:n
  {
    \prop_get:NnNTF \g_nt_covers_tikz_prop { #1 } \l_nt_covers_tmp_tl
      {
        \begin { tikzpicture }
          [ remember~picture, overlay, yscale = -1,
            every~node/.style = { inner~sep = 0pt } ]
          \tl_map_inline:Nn \l_nt_covers_tmp_tl
            { \nt_covers_render_tikz:nnnnn ##1 }
        \end { tikzpicture }
      }
      { }
  }

% #1 is the optional <cmd>, normalised to empty by \ntAddToCoverTikz when it
% was omitted (see there).  Testing for empty rather than string-comparing
% against xparse's internal "-NoValue-" marker keeps this independent of that
% marker's representation, which is not a documented interface.
\cs_new_protected:Nn \nt_covers_render_tikz:nnnnn
  {
    \tl_if_empty:nTF { #1 }
      { \node[#2] at (#3) #4 { #5 } }
      { #1[#2] (#3) #4 }
  }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% PUBLIC API - REGISTRATION
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\NewDocumentCommand{\ntresetcovers} { }
  { \seq_map_inline:Nn \g_nt_covers_ids_seq { \nt_covers_reset_one:n { ##1 } } }

\NewDocumentCommand{\ntresetonecover} { m }
  { \nt_covers_reset_one:n { #1 } }

% Command: \ntaddtocover[options]{cover-ids}{content}
% Purpose:  Add content to specified cover pages with optional filtering
%
% Args:
%   options  = Optional parameters for rendering/filtering:
%              - status={final,provisional,...}: Filter by document status
%              - degree={phd,phdprop,...}      : Filter by degree type
%              - vspace=2cm                    : Fixed vertical spacing (TeX dimension)
%              - vfill=1                       : Elastic vertical spacing (n × fill units)
%              - height=5cm                    : Fixed content height
%              - minheight=5cm                 : Minimum content height (padded if shorter)
%              - halign=l|c|r|j                : Horizontal alignment
%              - valign=t|c|b                  : Vertical alignment
%              - and more (see keys definition)
%   cover-ids = Comma-separated cover IDs (1-1, 1-2, 2-1, 2-2, N-1, N-2)
%   content  = LaTeX content to add to covers
%
% Example:
%   \ntaddtocover[degree={phd,phdprop}, vspace=1cm]{1-1,2-1}{%
%     This text appears on front and back covers for PhD and PhD Proposal degrees
%   }
%   \ntaddtocover[vfill=1]{1-1}{} % pushes following elements to the bottom
%
% Note: 'degree' takes a BRACED, COMMA-separated list, matched against \@DOCTYPE.
%       The braces are required: they keep the commas from being read as key
%       separators.  There is no slash-separated form -- 'degree=phd/msc' is a
%       single unmatchable value and the element would silently never render.
%       Valid doctypes (see nt-core.sty) are: phd, phdprop, phdplan, msc,
%       mscplan, bsc, plain.
\NewDocumentCommand { \ntaddtocover } { O { } m m }
  {
    \clist_map_inline:nn { #2 }
      {
        \nt_covers_add_to_prop:nnn \g_nt_covers_content_prop { ##1 }
          { { { #1 } { #3 } } }
      }
  }

% #1 = <cmd> (already normalised: empty means "use \node"), #2 = [opts],
% #3 = (position), #4 = [rest], #5 = {cover-ids}, #6 = {code}
\cs_new_protected:Nn \nt_covers_add_tikz:nnnnnn
  {
    \clist_map_inline:nn { #5 }
      {
        \nt_covers_add_to_prop:nnn \g_nt_covers_tikz_prop { ##1 }
          { { { #1 } { #2 } { #3 } { #4 } { #6 } } }
      }
  }

\NewDocumentCommand { \ntAddToCoverTikz } { d<> O { } r() O { } m m }
  {
    % Resolve the optional <cmd> here, where \IfNoValueTF is still meaningful,
    % and store it as an empty field when absent.  The renderer runs later, off
    % a property list, where the argument's "was it given?" status is gone.
    \IfNoValueTF { #1 }
      { \nt_covers_add_tikz:nnnnnn {    } { #2 } { #3 } { #4 } { #5 } { #6 } }
      { \nt_covers_add_tikz:nnnnnn { #1 } { #2 } { #3 } { #4 } { #5 } { #6 } }
  }

