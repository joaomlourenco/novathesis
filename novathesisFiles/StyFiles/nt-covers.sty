\NewDocumentCommand { \ntprintcovers } { O { 1,2 } }
  {
    \group_begin:
      \ntselectlang { \@LANG@COVER }
      \NTRunHook { printcovers/pre }
      \clist_map_inline:nn { #1 } { \ntprintcoverpair { ##1 } }
      \NTRunHook { printcovers/post }
    \group_end:
    \pagecolor { white }
  }

\NewDocumentCommand { \ntprintcoverpair } { m }
  {
    \iffileadded [#1] { cover }
      { \PrintAddedFile [#1] { cover } }
      {
        \str_case:nnF { #1 }
          {
            { 1 }
              {
                \ntprintcoversingle { 1 } { 1 }
                \ntprintcoversingle { 1 } { 2 }
              }
            { 2 }
              {
                \iftoggle { /novathesis/print/frontpage }
                  {
                    \ntprintcoversingle { 2 } { 1 }
                    \ntprintcoversingle { 2 } { 2 }
                  }
                  { }
              }
            { N }
              {
                \ntprintcoversingle { N } { 1 }
                \ntprintcoversingle { N } { 2 }
              }
          }
          {
            % Unknown pair id: without this branch a typo such as
            % \ntprintcovers[1,3] would print nothing at all, silently.
            \ClassWarning { novathesis }
              {
                Unknown~cover~pair~'#1'~ignored.~
                Valid~pair~ids~are~1,~2~and~N
              }
          }
      }
  }

\NewDocumentCommand { \ntprintcoversingle } { m m }
  {
    \ifcoverdefined [#1-#2]
      {
        \tl_gset:cn { @COVERNUM } { #1-#2 }
        \str_if_eq:nnTF { #1 } { 1 }
          { \pagenumbering { roman } \setcounter { page } { 0 } }
          { }
        \nt_covers_render_page:nn { #1 } { #2 }
        \ifoptionequal { /novathesis/media } { paper }
          { \str_if_eq:nnTF { #2 } { 1 } { \ifcoverdefined [#1-2] { } { \clearpage } } { } }
          { \clearpage }
      }
      { }
  }

\cs_new_protected:Nn \nt_covers_render_page:nn
  {
    \group_begin:
      \NTRunHook { cover/pre }
      \NTRunHook { cover/#1-#2/pre }
      \clearpage
      \phantomsection
      \def \bmshift { 1 }
      \str_if_eq:nnTF { #1-#2 } { 1-1 } { \def \bmshift { 0 } } { }
      % N-2 (Back Cover) renders after "Back Matter" (level -1, see
      % \ntprintlist) is already open, unlike 1-1 (Front Cover), which
      % renders before anything is open -- so level 0 would nest it as a
      % child of Back Matter instead of popping back out to the top.
      % -1 matches Back Matter's own level for the same reason Back
      % Matter itself needs -1 rather than Front Matter's 0.
      \str_if_eq:nnTF { #1-#2 } { N-2 } { \def \bmshift { -1 } } { }
      \bookmark
        [ level = \bmshift, dest = \HyperLocalCurrentHref ]
        { \GetBkmString ( #1-#2 ) }
      \thispagestyle { empty }

      % Step 1: Background Colour
      % \NTRunHook{cover/bgcolor/pre}       % reserved for future use
      % \NTRunHook{cover/#1-#2/bgcolor/pre} % reserved for future use
      \datamatchtf { \l_nt_covers_tmp_tl } { ThesisCover } (
        \nthierkeys { } { #1-#2,bgcolor } ,
        \nthierkeys { } { bgcolor }
      )
        { \pagecolor { \l_nt_covers_tmp_tl } }
        { \pagecolor { white } }
      % \NTRunHook{cover/#1-#2/bgcolor/post} % reserved for future use
      % \NTRunHook{cover/bgcolor/post}        % reserved for future use

      % Step 2: Background Image (full-page TikZ overlay)
      % \NTRunHook{cover/bgimage/pre}       % reserved for future use
      % \NTRunHook{cover/#1-#2/bgimage/pre} % reserved for future use
      \datamatchtf { \l_nt_covers_tmp_tl } { ThesisCover } (
        \nthierkeys { } { #1-#2,image } ,
        \nthierkeys { } { image }
      )
        {
          \begin { tikzpicture } [ remember~picture, overlay ]
            \node [ anchor = center ] at ( current~page.center )
              {
                \includegraphics
                  [ width = 1.005\paperwidth, height = \paperheight ]
                  { \l_nt_covers_tmp_tl }
              } ;
          \end { tikzpicture }
        }
        { }
      % \NTRunHook{cover/#1-#2/bgimage/post} % reserved for future use
      % \NTRunHook{cover/bgimage/post}        % reserved for future use

      % Steps 3+4: Text colour (set inside minipage) + Element rendering
      % cover/text/pre, cover/#1-#2/text/pre, cover/#1-#2/text/post, cover/text/post
      % are all fired inside \nt_covers_print_text:n, within the minipage group,
      % so font/colour changes in those hooks take effect correctly.
      % \NTRunHook{cover/text/pre}        % moved inside minipage (nt_covers_print_text:n)
      % \NTRunHook{cover/#1-#2/text/pre}  % moved inside minipage (nt_covers_print_text:n)
      \nt_covers_print_text:n { #1-#2 }
      \nt_covers_print_tikz:n { #1-#2 }
      % \NTRunHook{cover/#1-#2/text/post} % moved inside minipage (nt_covers_print_text:n)
      % \NTRunHook{cover/text/post}       % moved inside minipage (nt_covers_print_text:n)

      % Documented (app-covers.tex) as automatic for every cover page when
      % 'cover' is in \ntsetup{debug=...}; previously only wired up in
      % uminho/spine.tex's own legacy spine code, so every other school's
      % cover pages silently ignored it. Drawn last so the grid overlays
      % on top of the rendered elements, matching a measurement aid's job.
      \ifoptioncontains { /novathesis/debug } { cover } { \debuggrid } { }

      \NTRunHook { cover/#1-#2/post }
      \NTRunHook { cover/post }
    \group_end:
  }

