% Department
%============================================================

\NewMemStore { Department }

% 1. The Public Command
% s = star (*) <= only define if undefined
% r() = required ID in parens <= the lang code
% m = mandatory value <= the name of the department
\NewDocumentCommand { \ntdepartment } { s r() m }
 { 
 % We pass the star status (boolean) and expanded arguments to the internal logic
 \nova_process_department:nee { #1 } { #2 } { #3 }
 }

% 2. Internal Logic
\cs_new_protected:Npn \nova_process_department:nnn #1 #2 #3
 { 
 % Handle the optional ID: if empty/NoValue, use 'default'
 \tl_set:Nn \l_tmpa_tl { #2 }

 % Logic Branching
 \bool_if:nTF { #1 }
 { 
 % Starred version: Only set if NOT already defined
 % We check if the 'department' data for this ID is empty/unset
 \IfMemVoidT { Department } { \l_tmpa_tl }
 { \MemSet { Department } { \l_tmpa_tl } { #3 } }
 }
 { 
 % Unstarred version: Set/Overwrite regardless
 \MemSet { Department } { \l_tmpa_tl } { #3 }
 }
 }


% 3. Generate expansion variants
\cs_generate_variant:Nn \nova_process_department:nnn { nee }


% Scratch variables used across the field-command implementations below.
% (\l_tmpa_tl, \l_tmpb_tl, \l_tmpa_seq, \l_tmpb_seq are expl3 kernel pre-declarations.)
\tl_new:N \l__nt_tmpc_tl

% ─────────────────────────────────────────────────────────────────────────────
% \ntmajorfield(*)(lang){ value } — major field of study
% ─────────────────────────────────────────────────────────────────────────────
% Shared logic for \ntmajorfield / \ntminorfield: set <store>(lang) to <value>,
% unconditionally, or only if not already set (star variant).
\cs_new_protected:Npn \__nt_set_field_if_star:nnnn #1 #2 #3 #4
 {
 % #1 = star bool, #2 = store name, #3 = lang key, #4 = value
 \bool_if:nTF { #1 }
 { \IfMemVoidT { #2 } { #3 } { \MemSet* { #2 } { #3 } { #4 } } }
 { \MemSet* { #2 } { #3 } { #4 } }
 }

\NewDocumentCommand { \ntmajorfield } { s r() m }
 { \__nt_set_field_if_star:nnnn { #1 } { MajorField } { #2 } { #3 } }

% ─────────────────────────────────────────────────────────────────────────────
% \ntminorfield(*)(lang){ value } — minor field of study
% ─────────────────────────────────────────────────────────────────────────────
\NewDocumentCommand { \ntminorfield } { s r() m }
 { \__nt_set_field_if_star:nnnn { #1 } { MinorField } { #2 } { #3 } }

% ─────────────────────────────────────────────────────────────────────────────
% \ntdegreename(*)(lang){ value } — degree / programme name
% Prepends DegreeNamePrefix (if defined by the school) and also sets MajorField.
% ─────────────────────────────────────────────────────────────────────────────
\cs_new_protected:Npn \__nt_set_degreename:nn #1 #2
 { 
 \datamatch { \match } { DegreeNamePrefix } (%
 { \@DOCTYPE,\@DEGREEACR,\@LANG@COVER },%
 { \@DOCCLASS,\@DEGREEACR,\@LANG@COVER },%
 { \@DEGREEACR,\@LANG@COVER },%
 { \@DOCTYPE,\@LANG@COVER },%
 { \@DOCCLASS,\@LANG@COVER },%
 { \@LANG@COVER } %
 ) %
 \ifblank { \match }
 { \MemSet* { DegreeName } { #1 } { #2 } }
 { \MemSet* { DegreeName } { #1 } { \match\ #2 } } %
 \MemSet* { MajorField } { #1 } { #2 } %
 }
\NewDocumentCommand { \ntdegreename } { s r() m }
 { 
 \bool_if:nTF { #1 }
 { \IfMemVoidT { DegreeName } { #2 } { \__nt_set_degreename:nn { #2 } { #3 } } }
 { \__nt_set_degreename:nn { #2 } { #3 } }
 }

% ─────────────────────────────────────────────────────────────────────────────
% \ntspecialization(*)(lang){ value } — specialization track
% Prepends SpecializationString (if defined) and also sets MinorField.
% ─────────────────────────────────────────────────────────────────────────────
\cs_new_protected:Npn \__nt_set_specialization:nn #1 #2
 { 
 \datamatch { \specmatch } { SpecializationString } (%
 { \@DOCTYPE,\@DEGREEACR,\@LANG@COVER },%
 { \@DOCCLASS,\@DEGREEACR,\@LANG@COVER },%
 { \@DEGREEACR,\@LANG@COVER },%
 { \@DOCTYPE,\@LANG@COVER },%
 { \@DOCCLASS,\@LANG@COVER },%
 { \@LANG@COVER } %
 ) %
 \ifblank { \specmatch }
 { \MemSet* { Specialization } { #1 } { #2 } }
 { \MemSet* { Specialization } { #1 } { \specmatch\ #2 } } %
 \MemSet* { MinorField } { #1 } { #2 } %
 }
\NewDocumentCommand { \ntspecialization } { s r() m }
 { 
 \bool_if:nTF { #1 }
 {
 \IfMemVoidT { MinorField } { #2 }
 { \__nt_set_specialization:nn { #2 } { #3 } }
 }
 { \__nt_set_specialization:nn { #2 } { #3 } }
 }

% ─────────────────────────────────────────────────────────────────────────────
% \ntsponsors(order,type,lang){ value } — funding sponsor entry
% Parens hold three comma-separated fields: display order, content type
% (logo/text), and language code.
% Bug-fix: old code stored the "type" field as the value instead of the
% mandatory {value} argument (now #2).
% ─────────────────────────────────────────────────────────────────────────────
\NewDocumentCommand { \ntsponsors } { r() m }
 { 
 % Split "(order,type,lang)" on comma
 \seq_set_split:Nnn \l_tmpa_seq { , } { #1 }
 \tl_set:Ne \l_tmpa_tl { \seq_item:Nn \l_tmpa_seq { 1 } } % order
 \tl_set:Ne \l_tmpb_tl { \seq_item:Nn \l_tmpa_seq { 2 } } % type
 \tl_set:Ne \l__nt_tmpc_tl { \seq_item:Nn \l_tmpa_seq { 3 } } % lang
 \MemSet* { Sponsor }
 { \l__nt_tmpc_tl , \l_tmpa_tl , \l_tmpb_tl }
 { #2 }
 }

% ─────────────────────────────────────────────────────────────────────────────
% \nttitle(type,lang){ value } — document title
% Also stores a plain-text variant (no line-break commands) and, for type=main,
% sets the spine title to the same plain value.
% ─────────────────────────────────────────────────────────────────────────────
\NewDocumentCommand { \nttitle } { r() m }
 { 
 % Split "(type,lang)" on comma
 \seq_set_split:Nnn \l_tmpa_seq { , } { #1 }
 \tl_set:Ne \l_tmpa_tl { \seq_item:Nn \l_tmpa_seq { 1 } } % type
 \tl_set:Ne \l_tmpb_tl { \seq_item:Nn \l_tmpa_seq { 2 } } % lang
 \MemSet* { DocTitle } { \l_tmpb_tl , \l_tmpa_tl } { #2 }
 \NewlineToSpace { #2 } [ \l__nt_tmpc_tl ]
 \MemSet* { DocTitle } { \l_tmpb_tl , \l_tmpa_tl , plain } { \l__nt_tmpc_tl }
 \str_if_eq:eeTF { \l_tmpa_tl } { main }
 { \MemSet* { DocTitle } { \l_tmpb_tl , spine } { \l__nt_tmpc_tl } }
 { }
 }


% Define a temporary token list variable
\tl_new:N \l__memory_clean_tl

\NewDocumentCommand { \NewlineToSpace } { m o }
 { 
 % 1. Store the input (#1) into the variable
 \tl_set:Nn \l__memory_clean_tl { #1 }

 % 2. Perform the replacement.
 % In expl3, ~ represents a space token (catcode 10).
 % This replaces every occurrence of the token \\ with a space.
 \tl_replace_all:Nnn \l__memory_clean_tl { ~\\~ } { ~ }
 \tl_replace_all:Nnn \l__memory_clean_tl { ~\\ } { ~ }
 \tl_replace_all:Nnn \l__memory_clean_tl { \\~ } { ~ }
 \tl_replace_all:Nnn \l__memory_clean_tl { \\ } { ~ }

 % 3. Check if the optional argument (#2) is provided
 \IfNoValueTF { #2 }
 { 
 % If no optional arg: Output the result directly
 \tl_use:N \l__memory_clean_tl
 }
 { 
 % If optional arg exists: Set the provided macro (#2) to the result
 \tl_set_eq:NN #2 \l__memory_clean_tl
 }
 }


% \PrintDateISO { 2022-12-25 } -> localized date, e.g., December 20, 2022; 20 de dezembro de 2022
% \PrintDateISO { 2022-12 } -> e.g., December 20, 2022; Dezembro, 2022
% \PrintDateISO { 2022 } -> e.g., 2022
% \PrintDateISO*{ 2022-12 } -> e.g., DECEMBER, 2022 (starred = uppercase the month name)
%
% \nt_print_iso_date:nnn's own #2/#3 (separator/date string) are typeset
% directly by a \cs_new_protected: function, so they're opaque to
% \MakeUppercase -- \MakeUppercase{\PrintDateISO[~]{...}} silently does
% nothing, since \MakeUppercase can only see through fully expandable macros,
% and a protected function is deliberately immune to that kind of expansion.
% Wrapping just the already-expanded month name (\l_tmpa_tl, plain text by
% the time #1 is applied to it) from *inside* the protected function sidesteps
% that entirely, so the starred form does the right thing directly.
\NewDocumentCommand { \PrintDateISO } { s O{,~} m }
 {
 \IfBooleanTF { #1 }
   { \nt_print_iso_date:nnn { \MakeUppercase } { #2 } { #3 } }
   { \nt_print_iso_date:nnn { } { #2 } { #3 } }
 }

% Sequential variables to store Y, M, D
\seq_new:N \l_nt_date_seq
% Generate the 'Nne' variant (N = seq, n = delimiter, e = fully-expanded string)
\cs_generate_variant:Nn \seq_set_split:Nnn { Nne }

\cs_new_protected:Nn \nt_print_iso_date:nnn
   {
     % Split the input string by the hyphen (-)
     \seq_set_split:Nne \l_nt_date_seq { - } { #3 }

     \int_case:nn { \seq_count:N \l_nt_date_seq }
       {
         % Case 1: Only Year (YYYY)
         { 1 } { \seq_item:Nn \l_nt_date_seq { 1 } }

         % Case 2: Year and Month (YYYY-MM)
         { 2 } {
                 \tl_set:Ne \l_tmpa_tl { \babelmonthname { \seq_item:Nn \l_nt_date_seq { 2 } } }
                 \nt_titlecase_first:N \l_tmpa_tl
                 #1 { \tl_use:N \l_tmpa_tl }
                 #2 % separator
                 \seq_item:Nn \l_nt_date_seq { 1 } % year
         }

         % Case 3: Full Date (YYYY-MM-DD)
         { 3 } {
                 \localedate { \seq_item:Nn \l_nt_date_seq { 1 } }
                 { \seq_item:Nn \l_nt_date_seq { 2 } }
                 { \seq_item:Nn \l_nt_date_seq { 3 } }
         }
       }
   }


% Define the command with an optional d() argument and a mandatory m argument
\NewDocumentCommand { \SetDateISO } { d() m }
 { 
 \nt_set_iso_date:nn { #1 } { #2 }
 }

% Sequential variable to store the split parts
\seq_new:N \l_nt_parts_seq

\cs_new_protected:Nn \nt_set_iso_date:nn
 { 
 % 1. Store the raw ISO string
 \MemSet { DocDate } { #1 } { #2 }
 
 % 2. Split the string by the hyphen
 \seq_set_split:Nnn \l_nt_parts_seq { - } { #2 }
 
 % 3. Process based on how many parts were found
 \int_case:nn { \seq_count:N \l_nt_parts_seq }
 { 
 % Case: YYYY
 { 1 } 
 { 
 \MemSet* { DocDate } { #1, year } { \seq_item:Nn \l_nt_parts_seq { 1 } }
 }
 
 % Case: YYYY-MM
 { 2 }
 { 
 \MemSet* { DocDate } { #1, year } { \seq_item:Nn \l_nt_parts_seq { 1 } }
 \MemSet* { DocDate } { #1, month } { \seq_item:Nn \l_nt_parts_seq { 2 } }
 % Use Babel's \monthname to get the localized text
 \MemSet* { DocDate } { #1, month, text } 
 { \babelmonthname { \seq_item:Nn \l_nt_parts_seq { 2 } } }
 }
 
 % Case: YYYY-MM-DD
 { 3 }
 { 
 \MemSet* { DocDate } { #1, year } { \seq_item:Nn \l_nt_parts_seq { 1 } }
 \MemSet* { DocDate } { #1, month } { \seq_item:Nn \l_nt_parts_seq { 2 } }
 \MemSet* { DocDate } { #1, month, text } 
 { \babelmonthname { \seq_item:Nn \l_nt_parts_seq { 2 } } }
 \MemSet* { DocDate } { #1, day } { \seq_item:Nn \l_nt_parts_seq { 3 } }
 }
 }
 }


\ExplSyntaxOff


