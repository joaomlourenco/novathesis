%============================================================
% Print document “parts/sections/regions”
% Kept in LaTeX2e syntax for the same reason as \ntaddlistof above: the
% branches carry literal text, which \ExplSyntaxOn would strip spaces from.
\newcommand*{\ntprint}[1]{%
  \IfStrEqCase{#1}{%
    {frontcover}{%
          \thispagestyle{empty}%
          \pagestyle{empty}%
          \ntprintcovers%
    }%
    {frontmatter}{%
          \ntthesisfrontmatter% Before the main text (TOC, etc) — Roman page numbering
          \phantomsection
          \bookmark[level=0, dest=\HyperLocalCurrentHref]{\GetBkmString(frontmatter,\@LANG@MAIN)}
          % Nest all front-matter items under the "Front Matter" bookmark node.
          % \@nt@bkm@level=1 shifts \ChapterNoTitle pages (copyright, dedication, …)
          % to level 1; \shiftbookmarks shifts chapter-level items (list-ofs) likewise.
          % \bookmark[level=0]{Contents} and \bookmark[level=0]{List of…} use explicit
          % levels so they stay at level 0 and are unaffected by \shiftbookmarks.
          \begingroup
            \def\@nt@bkm@level{1}%
            \shiftbookmarks{\ntprintlist{#1_\@DOCSTATUS}}%
          \endgroup
    }%
    {mainmatter}{%
          \ntthesismainmatter% Main text — Arabic page numbering
          \thispagestyle{novathesis@mainmatter}%
          \pagestyle{novathesis@mainmatter}%
          \ntprintlist{#1}%
    }%
    {backmatter}{%
          \ntthesisbackmatter     % The back text — Arabic page numbering
          \phantomsection
          % level=-1 (not 0): "Front Matter" gets away with level=0 only because
          % nothing is open yet at a shallower level when it's written. By the
          % time "Back Matter" is written, a \part (level -1) may still be the
          % open ancestor, and a level=0 sibling of chapters would nest inside
          % it instead of popping back out to the top level. -1 matches \part's
          % own level, so this always closes back out to the top -- whether or
          % not the document uses \part at all (with no open ancestor at -1 or
          % shallower, a level=-1 bookmark still becomes a plain root, exactly
          % as level=0 did before in the no-\part case).
          \bookmark[level=-1, dest=\HyperLocalCurrentHref]{\GetBkmString(backmatter,\@LANG@MAIN)}
          \shiftbookmarks{\ntprintlist{#1}}%
    }%
    {backcover}{%
          \thispagestyle{empty}%
          \pagestyle{empty}%
          \ntprintbackcover%
    }%
  }[\ifcsmacro{ntprint#1}{\csuse{ntprint#1}}{\ifcsmacro{#1}{\csuse{#1}}{}}]%
}

% Print-order registries: which sections print, and in what order, for
% each of frontmatter (per docstatus)/mainmatter/backmatter. Were 5
% options-package lists (seeded with a default order, some fully
% replaced by school .clo files wanting a custom one); now 5 plain
% seqs. \@nt@printorder@set/@run are plain-named (no "_"/":") so
% classical code -- including every school .clo file -- can call them
% without needing ExplSyntaxOn active at the call site.
\ExplSyntaxOn
\seq_new:N \g__nt_print_frontmatter_final_seq
\seq_new:N \g__nt_print_frontmatter_provisional_seq
\seq_new:N \g__nt_print_frontmatter_working_seq
\seq_new:N \g__nt_print_mainmatter_seq
\seq_new:N \g__nt_print_backmatter_seq

% \@nt@printorder@set{<bucket>}{<item1,item2,...>} -- (re)set the print
% order for <bucket> (one of frontmatter_final, frontmatter_provisional,
% frontmatter_working, mainmatter, backmatter) to the given comma-list.
% Used both for the default declarations below and by school .clo files
% that want a fully custom order; the "set" semantics (full replace,
% not append) match \options{.../key = {...}}'s old behaviour exactly.
\cs_new_protected:Npn \@nt@printorder@set #1#2
  { \seq_set_from_clist:cn { g__nt_print_#1_seq } {#2} }

% \@nt@printorder@run{<bucket>}{<code, using #1 for the current item>}
% -- run <code> once per item registered under <bucket>, in order.
% l3seq has no generated ":c" variant of seq_map_inline (confirmed by
% testing directly -- unlike clist/seq_new, _gput_right, etc., which do),
% so the csname is built with the plain \csname/\expandafter primitives
% instead, which work identically regardless of ExplSyntaxOn state.
\cs_new_protected:Npn \@nt@printorder@run #1#2
  { \expandafter\seq_map_inline:Nn\csname g__nt_print_#1_seq\endcsname {#2} }
\ExplSyntaxOff

\newcommand*{\ntprintlist}[1]{%
  \@nt@printorder@run{#1}{%
    \begingroup
      \clearpage
      \ifcsmacro{ntprint##1}{%  \ntprint#1 is defined
        % \bookmarksetupnext{rellevel=1}%
        \NTRunHook{ntprint##1/pre}\csuse{ntprint##1}\NTRunHook{ntprint##1/post}%
      }{%                       \ntprint#1 is undefined
        \ifcsmacro{##1}{%       \##1 is defined
          % \bookmarksetupnext{rellevel=1}%
          \NTRunHook{##1/pre}\csuse{##1}\NTRunHook{##1/post}%
        }{%                     nothing is defined
          \ClassError{novathesis}{Invalid contents for frontmatter or mainmatter: [##1]}{}%
        }%
      }%
      % \unskip%
      \clearforchapter%
      \ignorespaces%
    \endgroup
  }%
}

% \ifoptionequal/\if@backmatter/\forallglossaries/\forglsentries/
% \printunsrtglossary are plain classical control sequences (no "_"/":"
% in their names), so they can be called freely from inside this expl3
% body. The listtypes registry check, the string comparison, and the
% not-empty flag (formerly a classical \newif) all move to expl3; none
% of this carries typeset prose -- "frontmatter"/"backmatter" are
% internal keywords, not document text.
\ExplSyntaxOn
\bool_new:N \l__nt_glossary_nonempty_bool

% Per-type title override lookup (glossaries/titles, see nt-core.sty).
% Parses the "type=Title,type2=Title2,..." option value on every call
% rather than caching it, since \ntsetup may run again between calls
% (e.g. a school .clo customizing it after the class default is set).
\clist_new:N \l__nt_glstitle_clist
\seq_new:N   \l__nt_glstitle_pair_seq
\tl_new:N    \l__nt_glstitle_key_tl
\tl_new:N    \l__nt_glstitle_result_tl
\tl_new:N    \l__nt_glstype_tl

% bib2gls's internal name for the main (undeclared-type) glossary is "main",
% not "glossary" -- but \ntaddfile{glossaries}[glossary]{...} is how users
% register its source files, so accept "glossary" as an alias for "main" in
% glossaries/groupheadings and glossaries/titles, matching that file-key.
\cs_new_protected:Npn \@nt@glstype_alias:n #1 % #1 = glossary type, already expanded
  {
    \str_if_eq:eeTF {#1} {main}
      { \tl_set:Nn \l__nt_glstype_tl {glossary} }
      { \tl_set:Nn \l__nt_glstype_tl {#1} }
  }
\cs_new_protected:Npn \@nt@glstitle_lookup:n #1 % #1 = glossary type, already expanded
  {
    \tl_clear:N \l__nt_glstitle_result_tl
    \clist_set:Ne \l__nt_glstitle_clist { \option{/novathesis/glossaries/titles} }
    \clist_map_inline:Nn \l__nt_glstitle_clist
      {
        \seq_set_split:Nnn \l__nt_glstitle_pair_seq {=} {##1}
        \int_compare:nNnT { \seq_count:N \l__nt_glstitle_pair_seq } = {2}
          {
            \tl_set:Ne \l__nt_glstitle_key_tl { \seq_item:Nn \l__nt_glstitle_pair_seq {1} }
            \tl_trim_spaces:N \l__nt_glstitle_key_tl
            \str_if_eq:eeT {#1} { \l__nt_glstitle_key_tl }
              {
                \tl_set:Ne \l__nt_glstitle_result_tl { \seq_item:Nn \l__nt_glstitle_pair_seq {2} }
                \tl_trim_spaces:N \l__nt_glstitle_result_tl
              }
          }
      }
  }

\cs_new_protected:Npn \myprintglossaries
  { % "glossaries" in listof/skip is just a friendlier spelling of
    % print/glossaries=false -- there being no \ntaddlistof entry for
    % glossaries to skip in the first place, unlike listoffigures & co.
    \ifoptioncontains {/novathesis/listof/skip} {glossaries}
      { \ntsetup{print/glossaries=false} }
      { }
    % ignore if no glossaries were defined
    \seq_if_in:NnTF \g__nt_listtypes_seq {glossaries}
      {
        \ifoptionequal {/novathesis/print/glossaries} {false}
          { }
          {
            \if@backmatter
              \def \@matter {backmatter}
            \else
              \def \@matter {frontmatter}
            \fi
            \str_if_eq:eeTF { \option{/novathesis/print/glossaries} } { \@matter }
              {
                \forallglossaries {\thisglossary}
                  {
                    \bool_set_false:N \l__nt_glossary_nonempty_bool
                    \forglsentries [\thisglossary] {\thisentry}
                      { \bool_set_true:N \l__nt_glossary_nonempty_bool }
                    \bool_if:NT \l__nt_glossary_nonempty_bool
                      {
                        \group_begin:
                          \exp_args:Ne \@nt@glstype_alias:n {\thisglossary}
                          \ifoptioncontains {/novathesis/glossaries/groupheadings} {\l__nt_glstype_tl}
                            { }
                            { \renewcommand*{\glsgroupheading}[1]{} }
                          \exp_args:Ne \@nt@glstitle_lookup:n {\l__nt_glstype_tl}
                          \tl_if_empty:NTF \l__nt_glstitle_result_tl
                            { \printunsrtglossary [type=\thisglossary] }
                            {
                              \printunsrtglossary
                                [ type=\thisglossary, title={\tl_use:N \l__nt_glstitle_result_tl} ]
                            }
                        \group_end:
                      }
                  }
              }
              { }
          }
      }
      { }
  }
\ExplSyntaxOff


