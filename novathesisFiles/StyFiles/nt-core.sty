% --------------------------------------------------------
% Variant of \@for with an optional final argument, that is
% executed iif the loop is not interrupted
% --------------------------------------------------------
% The outer \ntfor/\ntfor@i shells stay classical: their parameter text
% uses ":=" and "[...]" as literal delimiters that must keep catcode 12
% to match call sites written in normal-catcode context, so they cannot
% be defined while ExplSyntaxOn is active. Only the loop body itself
% (no delimiters, no document text) moves to expl3, via a plain-named
% (no "_"/":") auxiliary that classical code can call from anywhere.
\ExplSyntaxOn
\bool_new:N \l__nt_for_break_bool
\cs_new_protected:Npn \@nt@ntforloop #1#2#3#4
  { % #1=loop variable  #2=comma list  #3=per-iteration code  #4=else-branch
    \bool_set_false:N \l__nt_for_break_bool
    \clist_map_inline:nn {#2} { \xdef #1 {##1} #3 }
    \bool_if:NF \l__nt_for_break_bool {#4}
  }
\cs_new:Npn \ntforbreak
  { \bool_set_true:N \l__nt_for_break_bool \clist_map_break: }
