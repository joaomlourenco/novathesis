% --------------------------------------------------------
% PROCESSING CLASS OPTIONS
% Bridges \documentclass[key=value,...]{novathesis} into the option tree
% -- documented syntax (see app-internals.tex), though no real school
% config actually uses it (\documentclass{novathesis} is always called
% bare everywhere in this repo).
%
% \@classoptionslist is the WRONG kernel variable to read here: it is
% only ever populated by \ProcessOptions actually running, which
% novathesis.cls never calls (confirmed by grep) -- reading it raised
% "the key '\@classoptionslist' is unknown" instead of a comma-list. The
% old options.sty-based \options@ProcessOptions{/novathesis} avoided this
% because \option@ProcessClassOptions (see options.sty) reads a
% DIFFERENT, more fundamental kernel variable instead: \opt@<name>.<ext>
% (here, \opt@novathesis.cls), which \documentclass/\LoadClass populate
% with the class's raw bracketed options REGARDLESS of whether
% \ProcessOptions ever runs. Reusing that same variable here reproduces
% the old behaviour correctly instead of dropping the feature.
\ifcsvoid{opt@\@currname.\@currext}{}{%
  \ExplSyntaxOn
  \exp_args:Nne \keys_set:nn { novathesis } { \csname opt@\@currname.\@currext\endcsname }
  \ExplSyntaxOff
}%
% --------------------------------------------------------
% \ntsetup itself is defined in nt-options.sty (loaded from
% nt-packages.sty, before this file); the old hierarchical
% ".search also" school/university fallback it used to set up here is
% not replicated -- see that file's header for why.


\newcommand{\SpineSetup}[2][]{%
  \NTAddToHook{print/spine/pre}{%
    #1%
    \NTSetup[spine] {#2}%
  }%
}


