%% DATA MANAGEMENT (MEMORY)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% --------------------------------------------------------
% Search if a data/memory is defined and returns value


% Define a boolean to track if a match was found inside the loop
\bool_new:N \l__memory_match_found_bool

% Command: \datamatchtf
% Syntax:  \datamatchtf{\match}{MEMORYDATA}(list,of,keys){TRUE}{FALSE}
%
% #1: The macro to store the result (\match)
% #2: The memory data container name (MEMORYDATA)
% #3: The list of keys to search (in parentheses)
% #4: True branch code
% #5: False branch code

% \datamatchtf reads memstore's property lists (g__mem_<store>_prop) directly
% and so relies on memstore.sty's variants, in particular \prop_if_in:ceT,
% which memstore generates from the \prop_if_in:NnT base.  memstore is loaded
% by nt-packages.sty, i.e. before this file, so the variant is available here.
% Kept as a safety net in case that load order ever changes; a no-op otherwise.
\cs_if_exist:NF \prop_if_in:ceT
  { \cs_generate_variant:Nn \prop_if_in:NnT { ceT } }

\NewDocumentCommand { \datamatchtf } { s m m r() +m +m }
  {
    % Reset the found boolean to false at the start
    \bool_set_false:N \l__memory_match_found_bool

    % Initialize #2 to empty.  Done ONCE here rather than on every iteration:
    % the loop breaks as soon as a key matches, so re-clearing inside the loop
    % only repeated work for each non-matching key without changing the result
    % (no match -> #2 stays empty; match -> #2 is overwritten just below).
    \IfBooleanTF{#1}
      {
        % STARRED: #2 is a NAME (e.g., "myVar").
        % Use \tl_set:ce to construct the csname from the string.
        \tl_set:ce { #2 } { }
      }
      {
        % NON-STARRED: #2 is a MACRO (e.g., \myVar).
        % Use \tl_set:Ne to set it directly.
        \tl_set:Ne #2 { }
      }

    % Iterate through the comma-separated list of keys (#4 now, due to argument shift).
    \exp_args:Ne \clist_map_inline:nn { #4 }
      {
        % Look up key ##1 in the memstore property list for store #3
        \prop_if_in:ceT { g__mem_#3_prop } { ##1 }
          {
            % If the key exists in the store:
            % 1. Set the user's variable (#2) to the stored value.
            
            \IfBooleanTF{#1}
              { 
                % STARRED: #2 is a NAME (e.g., "myVar"). 
                % Use \tl_set:cn to construct the csname from the string.
                \tl_set:ce { #2 } { \prop_item:ce { g__mem_#3_prop } { ##1 } } 
              }
              { 
                % NON-STARRED: #2 is a MACRO (e.g., \myVar). 
                % Use \tl_set:Nn to set it directly.
                \tl_set:Ne #2 { \prop_item:ce { g__mem_#3_prop } { ##1 } } 
              }

            % 2. Mark that we found a match
            \bool_set_true:N \l__memory_match_found_bool

            % 3. Break the loop immediately
            \clist_map_break:
          }
      }

    % Execute the appropriate branch based on whether a match was found
    % True branch is #5, False branch is #6
    \bool_if:NTF \l__memory_match_found_bool
      { #5 } % Match found
      { #6 } % No match found
  }

\NewDocumentCommand { \datamatch } { s m m r() }
  {
    % Argument mapping:
    % #1 = Star (boolean)
    % #2 = Macro to set / Name of macro (if starred)
    % #3 = Data ID (memory context)
    % #4 = List of keys (inside parens)

    \IfBooleanTF{#1}
      { 
        % Starred version: call \datamatchtf*
        \datamatchtf* { #2 } { #3 } ( #4 )
      }
      { 
        % Non-starred version: call \datamatchtf
        \datamatchtf  { #2 } { #3 } ( #4 ) 
      }
      % --- True Branch (Match Found) ---
      { } 
      % --- False Branch (No Match) ---
      { 
        % Note: In expl3, spaces are ignored, so we use ~ for spaces in text.
        \ClassError { novathesis }
          { Could~not~find~' #3 '~defined~with~any~of~' ( #4 ) '! }
          { }
      }
  }

\NewDocumentCommand { \datamatchcs } { s m m r() }
  {
    \IfBooleanTF{#1}
    {
      % Using expl3 syntax to expand the first argument into a csname
      \exp_args:NNc \datamatch * { #2 } { #3 } ( #4 )
    }
    {
      % Using expl3 syntax to expand the first argument into a csname
      \exp_args:Nc \datamatch { #2 } { #3 } ( #4 )
    }

  }

% --------------------------------------------------------
% Canonical key-hierarchy generator for \datamatch(tf) chains
%
% \nthierkeys{<prefix>}{<suffix>}
%
% Fully expandable.  Expands to the canonical 6-key fallback tier
% (most specific first):
%
%   { <prefix> \@DOCTYPE  , \@DEGREEACR , <suffix> } ,
%   { <prefix> \@DOCCLASS , \@DEGREEACR , <suffix> } ,
%   { <prefix> \@DEGREEACR , <suffix> } ,
%   { <prefix> \@DOCTYPE  , <suffix> } ,
%   { <prefix> \@DOCCLASS , <suffix> } ,
%   { <prefix> <suffix> }
%
% <prefix> must be empty or end with a comma (e.g. "cover,").
% <suffix> is the trailing key part (e.g. "1-1,textcolor" or "textcolor").
%
% Cover lookups use two tiers, cover-specific first, so that any
% per-cover setting always beats any global (degree-wide) one:
%
%   \datamatchtf { \tl } { ThesisCover }
%     ( \nthierkeys{}{1-1,bgcolor} , \nthierkeys{}{bgcolor} ) {...}{...}
%
% Designed for use inside the e-expanded key lists of \datamatch,
% \datamatchtf, and \datamatchcs, but works in any e/x expansion context.
\cs_new:Npn \nthierkeys #1 #2
  {
    { #1 \@DOCTYPE  , \@DEGREEACR , #2 } ,
    { #1 \@DOCCLASS , \@DEGREEACR , #2 } ,
    { #1 \@DEGREEACR , #2 } ,
    { #1 \@DOCTYPE  , #2 } ,
    { #1 \@DOCCLASS , #2 } ,
    { #1 #2 }
  }

\ExplSyntaxOff


