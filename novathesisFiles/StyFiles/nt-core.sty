% ---------------------------------------------------------
% 2. User Interface to Add Rules (replacement for \validprocessor)
% ---------------------------------------------------------

% Syntax: \AddValidProcessor{key}{list,of,engines}
\NewDocumentCommand { \AddValidProcessor } { m m }
  {
    \prop_gput:Nnn \g_novathesis_proc_rules_prop { #1 } { #2 }
  }

% Reusable engine-in-clist test used below by both \ValidateLtxProcessor
% and \NTRequireEngine. \clist_if_in:N.../:n... comparisons against
% \g_novathesis_current_engine_str (a str variable) do not work: str
% variables store their content with every character forced to catcode 12
% ("other"), and \clist_if_in's own comparison is catcode-sensitive, so it
% never matches a clist built from ordinary document-mode text (normal
% catcodes) even when the two are visibly the same string -- confirmed by
% direct testing, including \tl_set:Ne-copying the str into a plain tl
% first (still fails, since the catcode-12 tokens are what gets copied).
% \str_if_eq:VnT IS str-aware (compares by character code, ignoring
% catcode), so looping the clist and testing each item that way is what
% actually works.
\bool_new:N \l__nt_engineok_bool
\cs_new_protected:Npn \__nt_check_engine_in_clist:N #1
  {
    \bool_set_false:N \l__nt_engineok_bool
    \clist_map_inline:Nn #1
      {
        \str_if_eq:VnT \g_novathesis_current_engine_str { ##1 }
          { \bool_set_true:N \l__nt_engineok_bool \clist_map_break: }
      }
  }

% ---------------------------------------------------------
% 3. The Main Validator
% ---------------------------------------------------------

% Message definition for the error
\msg_new:nnnn { novathesis } { invalid-processor }
  { Invalid~processor~for~"#1". }
  {
    You~are~using~\g_novathesis_current_engine_str~(la)tex,~
    but~"#1"~only~allows:~#2.
  }

% Generate the "NeNTF" variant used below to look up hierarchy keys built
% from expanded macro arguments (#1/#2/#3 etc.). Guarded with \cs_if_exist:NF
% since some l3kernel releases may already provide this variant natively;
% calling \cs_generate_variant:Nn on an already-existing name is not safe to
% assume harmless across kernel versions.
\cs_if_exist:NF \prop_get:NeNTF
  { \cs_generate_variant:Nn \prop_get:NnNTF { NeNTF } }

\NewDocumentCommand { \ValidateLtxProcessor } { m m m }
  {
    % #1 = Univ, #2 = School, #3 = Degree

    % Reset flags
    \bool_set_false:N \l_novathesis_rule_found_bool

    % -----------------------------------------------------
    % A. Hierarchy Lookup (Univ/Sch/Deg -> Univ/Sch -> Univ)
    % -----------------------------------------------------

    % 1. Check Univ/School/Degree
    \prop_get:NeNTF \g_novathesis_proc_rules_prop { #1/#2/#3 }
      \l_novathesis_found_rule_tl
      { \bool_set_true:N \l_novathesis_rule_found_bool }
      {
        % 2. Check Univ/School
        \prop_get:NeNTF \g_novathesis_proc_rules_prop { #1/#2 }
          \l_novathesis_found_rule_tl
          { \bool_set_true:N \l_novathesis_rule_found_bool }
          {
            % 3. Check Univ -- :NeNTF (expanding), NOT :NnNTF: #1 here is
            % the literal token \@UNIV (macro arguments aren't expanded by
            % default), and levels 1/2 above already correctly use the
            % expanding "e" variant to turn it into e.g. "uminho" before
            % searching the prop. Using the non-expanding "n" variant here
            % searched for the key "\@UNIV" itself, which never matches
            % anything \AddValidProcessor ever registers (plain, already-
            % literal strings like "uminho") -- so any school relying on
            % this fallback (Univ-only rule, no School/Degree-specific
            % one) silently never got validated at all.
            \prop_get:NeNTF \g_novathesis_proc_rules_prop { #1 }
              \l_novathesis_found_rule_tl
              { \bool_set_true:N \l_novathesis_rule_found_bool }
              {
                % No rule found: Do nothing (Implicitly Valid)
              }
          }
      }

    % -----------------------------------------------------
    % B. Validation Logic
    % -----------------------------------------------------

    \bool_if:NT \l_novathesis_rule_found_bool
      {
        % Check if the current engine is in the allowed list
        \__nt_check_engine_in_clist:N \l_novathesis_found_rule_tl
        \bool_if:NF \l__nt_engineok_bool
          {
            % ERROR: Engine not found in allowed list
            \msg_error:nnxx { novathesis } { invalid-processor }
              { #1/#2/#3 }
              { \clist_use:Nn \l_novathesis_found_rule_tl { ,~ } }
          }
      }
  }

% ---------------------------------------------------------
% 4. Helper: Print current processor name (The \pdfprocessor equivalent)
% ---------------------------------------------------------
\NewDocumentCommand { \PrintProcessorName } { }
  {
    \str_case:Vn \g_novathesis_current_engine_str
      {
        { pdf } { \hologo{pdfLaTeX} }
        { lua } { \hologo{luaLaTeX} }
        { xe }  { \hologo{XeLaTeX} }
      }
  }

% ── \AddValidDegree{key}{degrees} / \ValidateDegree{u}{s}{d} ───────────
% Same hierarchy-lookup shape as \AddValidProcessor/\ValidateLtxProcessor
% above (Univ/School/Degree -> Univ/School -> Univ, looked up with the
% expanding "e" prop-key variant for the same reason noted on
% \ValidateLtxProcessor), but for which doctypes ("degrees") a school
% offers rather than which (La)TeX engine it needs. Two doctype-vocabulary
% rules are baked in here, rather than requiring every declaration to
% spell every variant out:
%   - "phd" also covers phdplan/phdprop, and "msc" also covers mscplan --
%     proposal/plan phases of the same degree, not a separate programme;
%   - doctype=plain (no specific degree) is never restricted -- it is a
%     generic fallback, not a school-specific programme.

\prop_new:N \g_novathesis_degree_rules_prop
\tl_new:N  \l_novathesis_found_degree_tl
\bool_new:N \l_novathesis_degree_rule_found_bool

% Syntax: \AddValidDegree{key}{list,of,doctypes}
\NewDocumentCommand { \AddValidDegree } { m m }
  {
    \prop_gput:Nnn \g_novathesis_degree_rules_prop { #1 } { #2 }
  }

% Expands the family shorthands above into \l__nt_degree_expanded_clist,
% checked instead of the raw declaration; error messages still quote the
% raw declaration (#1), so what's displayed matches what was written.
\clist_new:N \l__nt_degree_expanded_clist
\cs_new_protected:Npn \__nt_expand_degree_families:N #1
  {
    \clist_set:NV \l__nt_degree_expanded_clist #1
    \clist_if_in:NnT #1 { phd }
      { \clist_put_right:Nn \l__nt_degree_expanded_clist { phdplan, phdprop } }
    \clist_if_in:NnT #1 { msc }
      { \clist_put_right:Nn \l__nt_degree_expanded_clist { mscplan } }
  }

% Same manual clist_map_inline + str_if_eq loop \__nt_check_engine_in_clist:N
% uses above, for the same reason: catcode-12 str-variable comparisons are
% unreliable with \clist_if_in. Not actually at risk here (neither side is
% a \str_new:N variable), but kept consistent with its sibling check.
\bool_new:N \l__nt_degreeok_bool
\cs_new_protected:Npn \__nt_check_degree_in_clist:N #1
  {
    \__nt_expand_degree_families:N #1
    \bool_set_false:N \l__nt_degreeok_bool
    \clist_map_inline:Nn \l__nt_degree_expanded_clist
      {
        \str_if_eq:eeT { ##1 } { \option{/novathesis/doctype} }
          { \bool_set_true:N \l__nt_degreeok_bool \clist_map_break: }
      }
  }

\msg_new:nnnn { novathesis } { invalid-degree }
  { Invalid~degree~for~"#1". }
  {
    You~selected~doctype=\option{/novathesis/doctype},~
    but~"#1"~only~offers:~#2.
  }

\NewDocumentCommand { \ValidateDegree } { m m m }
  {
    % #1 = Univ, #2 = School, #3 = Degree (school-variant, or the current
    % doctype when the school string had no third segment -- same value
    % \ValidateLtxProcessor's own third argument already is at the call
    % site in nt-setup.sty, reused here unchanged)

    \bool_set_false:N \l_novathesis_degree_rule_found_bool

    \str_if_eq:eeTF { \option{/novathesis/doctype} } { plain }
      { } % plain is never restricted -- see the note above
      {
        % A. Hierarchy Lookup (Univ/Sch/Deg -> Univ/Sch -> Univ)
        \prop_get:NeNTF \g_novathesis_degree_rules_prop { #1/#2/#3 }
          \l_novathesis_found_degree_tl
          { \bool_set_true:N \l_novathesis_degree_rule_found_bool }
          {
            \prop_get:NeNTF \g_novathesis_degree_rules_prop { #1/#2 }
              \l_novathesis_found_degree_tl
              { \bool_set_true:N \l_novathesis_degree_rule_found_bool }
              {
                \prop_get:NeNTF \g_novathesis_degree_rules_prop { #1 }
                  \l_novathesis_found_degree_tl
                  { \bool_set_true:N \l_novathesis_degree_rule_found_bool }
                  {
                    % No rule found: Do nothing (Implicitly Valid)
                  }
              }
          }

        % B. Validation Logic
        \bool_if:NT \l_novathesis_degree_rule_found_bool
          {
            \__nt_check_degree_in_clist:N \l_novathesis_found_degree_tl
            \bool_if:NF \l__nt_degreeok_bool
              {
                \msg_error:nnxx { novathesis } { invalid-degree }
                  { #1/#2/#3 }
                  { \clist_use:Nn \l_novathesis_found_degree_tl { ,~ } }
              }
          }
      }
  }

% ---------------------------------------------------------
% 5. Engine requirement for individual FontStyles/*.sty files
% ---------------------------------------------------------
% \AddValidProcessor/\ValidateLtxProcessor above are keyed by
% Univ/School/Degree and run ONCE, early, at school-selection time
% (nt-setup.sty) -- before style/font is even resolved. They can't catch
% a font-specific requirement: a school's bundled default font may need
% XeTeX/LuaTeX even though the school itself has no such restriction (the
% user may freely \ntsetup{style/font=...} to something pdfLaTeX-
% compatible instead). Several FontStyles/*.sty files instead grew their
% own ad hoc "\ifxeorlua{}{\ClassError{...}}" guard, each with different
% wording, and four more (arial/calibri/futura/verdana) call fontspec
% commands with no guard at all -- under pdfLaTeX, \setmainfont doesn't
% even exist (fontspec isn't loaded), so the failure is a raw "Undefined
% control sequence" instead of a clear message.
%
% \NTRequireEngine{<label>}{<comma-list-of-allowed-engines>}, called from
% the font file itself at the point it actually needs XeTeX/LuaTeX, gives
% every one of them the same clear, standardized message, reusing the
% existing "invalid-processor" wording above and the same str-aware
% engine check \ValidateLtxProcessor uses (see \__nt_check_engine_in_clist:N
% above).
\clist_new:N \l__nt_requireengine_clist
\NewDocumentCommand { \NTRequireEngine } { m m }
  {
    \clist_set:Nn \l__nt_requireengine_clist {#2}
    \__nt_check_engine_in_clist:N \l__nt_requireengine_clist
    \bool_if:NF \l__nt_engineok_bool
      {
        \msg_error:nnxx { novathesis } { invalid-processor }
          {#1}
          { \clist_use:Nn \l__nt_requireengine_clist { ,~ } }
      }
  }




% ── File existence utilities ───────────────────────────────────────────
% \IfFileExistsInDirsTF, \IfFileExistsCase, \IfFontExistsCase,
% \InputIfFileExistsInDirsTF — starred (*) processes all matches;
% non-starred stops on first success

% Each file-search command below uses its OWN found-flag, so that nesting one
% inside another's action code cannot clobber the outer result (they used to
% share a single \l_file_found_bool).  \IfFileExistsInDirsTF sets its flag
% globally to escape the \group_begin:/\group_end: that scopes its scratch
% variables; the others set their flags locally.
\bool_new:N \g__nt_fileindirs_found_bool
\bool_new:N \l__nt_filecase_found_bool
\bool_new:N \l__nt_inputindirs_found_bool
% Scratch variables for \IfFileExistsInDirsTF, declared once (previously
% \tl_new was called inside the command body, which errored on the 2nd call).
\tl_new:N \l__nt_fileindirs_dir_tl
\tl_new:N \l__nt_fileindirs_path_tl
\tl_new:N \l__nt_fileindirs_lastchar_tl

\NewDocumentCommand { \IfFileExistsInDirsTF } { s O { } m m m m }
 {
  \bool_gset_false:N \g__nt_fileindirs_found_bool
  \group_begin:
    \clist_map_inline:nn { #4 }
     {
      \tl_set:Nn \l__nt_fileindirs_dir_tl { ##1 }
      \tl_trim_spaces:N \l__nt_fileindirs_dir_tl

      % Smart Slash Logic
      \tl_if_empty:NF \l__nt_fileindirs_dir_tl
       {
        \tl_set:Nx \l__nt_fileindirs_lastchar_tl
          { \tl_item:Nn \l__nt_fileindirs_dir_tl { -1 } }
        \str_if_eq:VnF \l__nt_fileindirs_lastchar_tl { / }
         { \tl_put_right:Nn \l__nt_fileindirs_dir_tl { / } }
       }

      % CONSTRUCT FULL PATH: Prefix + Dir + Filename
      \tl_set:Nx \l__nt_fileindirs_path_tl { #2 \l__nt_fileindirs_dir_tl #3 }

      \file_if_exist:nT { \l__nt_fileindirs_path_tl }
       {
        \bool_gset_true:N \g__nt_fileindirs_found_bool
        \xdef\ntfoundpath{ \l__nt_fileindirs_path_tl }
        #5
        \IfBooleanF { #1 } { \clist_map_break: }
       }
     }
  \group_end:

  \bool_if:NF \g__nt_fileindirs_found_bool { #6 }
 }


% \IfFileExistsCase*[search-path]{ {file1}{action1}, {file2}{action2} }{ default-action }
% * (Optional): logic defined in the underlying expl3 code.
% #2 (Optional): A specific directory or path to prepend to the filenames.
% #3 (Mandatory): A comma-separated list of pairs formatted as {filename}{code to run if found}.
% #4 (Mandatory): The "Else" branch. This code runs only if none of the files in your list are found.
\NewDocumentCommand { \IfFileExistsCase } { s O { } m m }
  {
    \bool_set_false:N \l__nt_filecase_found_bool
    \clist_map_inline:nn { #3 }
      {
        % ##1 is {filepath}{action}
        \__filecase_split_pair:nnnn { #1 } { #2 } ##1
      }
    % Else branch
    \bool_if:NF \l__nt_filecase_found_bool { #4 }
  }

% #1: Starred status
% #2: Prefix
% #3: Filename
% #4: Action
% Own scratch variables rather than the kernel's shared \l_tmpa_tl/\l_tmpb_tl:
% the action code (#4) typically \input{}s the file just found, and that file
% may re-enter \IfFileExistsCase, which would clobber a shared scratch.
\tl_new:N \l__nt_filecase_path_tl
\tl_new:N \l__nt_filecase_noext_tl

\cs_new_protected:Npn \__filecase_split_pair:nnnn #1 #2 #3 #4
  {
    % 1. Construct the full path
    \tl_set:Nn \l__nt_filecase_path_tl { #2 #3 }

    \file_if_exist:nT { \l__nt_filecase_path_tl }
      {
        \bool_set_true:N \l__nt_filecase_found_bool

        \tl_set_eq:NN \l__nt_filecase_noext_tl \l__nt_filecase_path_tl

        % Regex: Match a dot, followed by non-dots and non-slashes, until end of string.
        % This ensures we don't accidentally match a dot in a directory name (e.g. "ver.1/img").
        \regex_replace_once:nnN { \.[^./]*\Z } { } \l__nt_filecase_noext_tl

        \xdef\ntfoundpath{ \l__nt_filecase_path_tl }
        \xdef\ntfoundpathnoext{ \l__nt_filecase_noext_tl }
        #4
        
        % Break if not starred
        \bool_if:NF #1 { \clist_map_break: }
      }
  }


% Own found-flag rather than the kernel's shared scratch boolean: the action
% code (#3) runs inside the loop and may itself use that shared scratch, which
% would corrupt the "no font found" test performed after the loop.
\bool_new:N \l__nt_fontcase_found_bool

\NewDocumentCommand { \IfFontExistsCase } { s m m }
  {
    \bool_set_false:N \l__nt_fontcase_found_bool
    \clist_map_inline:nn { #2 }
      {
        % Check if the command \IfFontExistsTF exists (provided by fontspec)
        \cs_if_exist:cTF { IfFontExistsTF }
          {
            \IfFontExistsTF { ##1 }
              {
                \bool_set_true:N \l__nt_fontcase_found_bool
                % Execute the code #3, passing the found font name (##1)
                #3 { ##1 }
                % If starred, break the loop after the first match
                \IfBooleanT { #1 } { \clist_map_break: }
              }
              { } % Do nothing if font doesn't exist
          }
          {
            % Fallback if fontspec isn't loaded or engine is pdfLaTeX
            \typeout { novathesis:~fontspec~not~loaded.%
              ~Skipping~font~check~for~##1. }
          }
      }
    
    % Optional: warning if NO fonts from the list were found
    \bool_if:NF \l__nt_fontcase_found_bool
      {
        \typeout
          { novathesis:~Warning:~No~fonts~from~the~list~{ #2 }~were~found. }
      }
  }


% --------------------------------------------------------
% Input the file from the first dir list (if any)
% #1 = file name
% #2 = list of directories
% #3 = code if succeed [OPTIONAL]
% #4 = code if fails [OPTIONAL]

% 1. Create variables
\NewDocumentCommand { \InputIfFileExistsInDirsTF } { m m +m +m }
  {
    \bool_set_false:N \l__nt_inputindirs_found_bool

    % Iterate through directories (#2)
    \clist_map_inline:nn { #2 }
      {
        % Check if 'directory/filename' exists
        \file_if_exist:nTF { ##1 / #1 }
          {
            % A. Input the file
            \file_input:n { ##1 / #1 }

            % B. Execute Success Code (#3)
            #3

            % C. Mark found and break loop
            \bool_set_true:N \l__nt_inputindirs_found_bool
            \clist_map_break:
          }
          {}
      }

    % Handle 'Not Found' case
    \bool_if:NF \l__nt_inputindirs_found_bool
      { #4 }
  }




% Default bookmark level for \ChapterNoTitle items.
% Set to 1 inside \ntprint{frontmatter} so they nest under the Front Matter node.
\def\@nt@bkm@level { 0 }

% 1. Define the internal logic (accepts the argument as-is)
\cs_new_protected:Nn \__user_chapter_logic:n
 {
  % Note: Inside ExplSyntaxOn, spaces are ignored, so we don't need % at EOL
  \clearforchapter
  
  % Create the anchor. 
  % #1 is now the fully expanded string (e.g., "Project Alpha").
  \phantomsection%
  \bookmark[level=\@nt@bkm@level, dest=\HyperLocalCurrentHref] { #1 }
  
  % Reset spacing/formatting
  \noindent \ignorespaces
 }


% 2. Generate the variant that forces expansion ('e' = expand fully)
\cs_generate_variant:Nn \__user_chapter_logic:n { e }

% 3. User Interface
\NewDocumentCommand { \ChapterNoTitle } { m }
 {
  % Call the expanded variant.
  % This turns \ChapterNoTitle{\myMacro} into \__user_chapter_logic:n {Expanded Value}
  \__user_chapter_logic:e { #1 }
 }

