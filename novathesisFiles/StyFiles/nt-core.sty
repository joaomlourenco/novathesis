% ── \IfBeginsWithAnyOf{text}{prefix_list}{true}{false} ────────────────

% 1. Create Variables
\int_new:N \l__nt_check_len_int
\str_new:N \l__nt_slice_str
\tl_new:N \l__nt_clean_input_tl
\bool_new:N \l__nt_match_found_bool

% 2. Generate the missing variant
%    This forces \str_range to accept an expanded ('e') first argument.
\cs_generate_variant:Nn \str_range:nnn { enn }

\NewDocumentCommand { \IfBeginsWithAnyOf } { m m +m +m }
 {
  % Step A: Store and clean the input string
  \tl_set:Nn \l__nt_clean_input_tl { #1 }
  \tl_trim_spaces:N \l__nt_clean_input_tl
  
  \bool_set_false:N \l__nt_match_found_bool
  
  % Step B: Iterate through prefixes
  \clist_map_inline:nn { #2 }
   {
    % Get length of the current prefix (##1)
    \int_set:Nn \l__nt_check_len_int { \str_count:n { ##1 } }
    
    % Step C: Extract substring
    % We use the generated ':enn' variant to expand \l__nt_clean_input_tl
    % into actual text (e.g., "Apple") BEFORE slicing.
    \str_set:Nx \l__nt_slice_str 
      { 
        \str_range:enn { \l__nt_clean_input_tl } { 1 } { \l__nt_check_len_int } 
      }
    
    % Step D: Compare
    \exp_args:No \str_if_eq:nnTF \l__nt_slice_str { ##1 }
     {
      \bool_set_true:N \l__nt_match_found_bool
      \clist_map_break: 
     }
     { }
   }
   
  \bool_if:NTF \l__nt_match_found_bool { #3 } { #4 }
 }




