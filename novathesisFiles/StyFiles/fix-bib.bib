% The title, author and DOI below MUST match the Zenodo record exactly, so that
% Google Scholar clusters every citation into a single record.  The DOI is the
% *concept* DOI: it is version-independent and always resolves to the latest
% release.  For the same reason the year is FIXED and must not be bumped on a
% new release — a moving year would split the citations across one record per
% year.  "LaTeX" is deliberately plain text (not \LaTeX or \hologo): the logo is
% a kerned, raised construction that PDF text extraction mangles into "LATEX",
% which defeats the matching.
%
% 'ids' keeps the old key 'novathesis-manual' working as an alias, so every
% thesis that already says \cite{novathesis-manual} keeps building unchanged;
% the template itself cites the canonical key below.
@manual{novathesis-manual:2026:jlourenco,
  ids          = {novathesis-manual},
  title        = {\textbf{nova}thesis — The Manual: A LaTeX template for theses and dissertations},
  author       = {Lourenço, João M.},
  doi          = {10.5281/zenodo.21938603},
  year         = {2026},
  note         = {Version~\novathesisversion},
  citations    = {0},
  keywords     = {pedagogic,manual,rank-X},
}

