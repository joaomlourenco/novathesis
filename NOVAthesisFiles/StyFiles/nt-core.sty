% --------------------------------------------------------
% Automatically download necessary fonts if using lualatex
% --------------------------------------------------------

\NewDocumentCommand { \ntcheckfonts } {
    O { ttf }
    m
    m
    O { https://raw.githubusercontent.com/%
      joaomlourenco/novathesis-extras/main/Fonts }
    O { \DIRFONTSTYLES/Fonts } }
{
  % #1 = format (ttf)
  % #2 = font name (Calibri)
  % #3 = variants (Regular,Italic,Bold,BoldItalic)
  % #4 = base URL
  % #5 = target folder

  % Check if using XeLaTeX or LuaLaTeX
  \ifxeorlua
  {
    % Check if shell escape is enabled (compatible with all engines)
    \sys_if_shell_unrestricted:TF
    {
      \nt_check_fonts:nnnnn { #1 } { #2 } { #3 } { #4 } { #5 }
    }
    {
      \msg_error:nn { ntfonts } { shell-escape-required }
    }
  }
  {
    \ClassError { novathesis }
      { Font~style~" #2 "~is~not~compatible~with~pdfLaTeX.~
        Please~use~XeLaTeX~or~LuaLaTeX }
      { Please~use~XeLaTeX~or~LuaLaTeX } %
  }
}

\msg_new:nnn { ntfonts } { shell-escape-required }
{
  Font~download~requires~shell~escape.~\\
  Please~compile~with:~
  \token_to_str:N lualatex \c_space_tl \c_sys_jobname_str
  \c_space_tl -shell-escape
}

% Portable null device: /dev/null on Unix, nul on Windows (used to silence
% "command not found" stderr from the tool-availability probes below).
\sys_if_platform_windows:TF
  { \tl_const:Nn \c__nt_devnull_tl { nul } }
  { \tl_const:Nn \c__nt_devnull_tl { /dev/null } }

% \sys_get_shell:nnN does NOT expand its command, so \c__nt_devnull_tl would
% reach the shell verbatim and create a stray file named after the macro.
% Use an e-expanding variant for the probes so the null device is resolved.
\cs_generate_variant:Nn \sys_get_shell:nnN { enN }

\msg_new:nnn { ntfonts } { download-failed }
{
  Could~not~download~the~font~from~'#1';~no~file~was~created~at~'#2'.~\\
  Fetch~it~manually~from~
  https://github.com/joaomlourenco/novathesis-extras/tree/main/Fonts
}

\seq_new:N \l__nt_variants_seq
\tl_new:N \l__nt_filename_tl
\tl_new:N \l__nt_remote_url_tl
\tl_new:N \l__nt_local_path_tl
\str_new:N \l__nt_font_check_str

% --------------------------------------------------------
% SECURITY: validate every font-download argument before it is
% interpolated into a shell command.  \ntcheckfonts only runs with
% shell escape enabled, so an argument carrying shell metacharacters
% could execute arbitrary commands during the download.  Names,
% formats and variants must be plain identifiers ([A-Za-z0-9._-]);
% URLs and target paths may not contain shell metacharacters.  Every
% component of the download URL and local path is checked here, and
% the shell commands below additionally single-quote each field.
\cs_generate_variant:Nn \regex_match:nnTF { nV }

\msg_new:nnnn { ntfonts } { unsafe-token }
  { Refusing~to~download~font:~unsafe~#1~'#2'. }
  {
    The~#1~may~contain~only~letters,~digits,~'.',~'_'~and~'-'.
    A~value~with~other~characters~could~inject~shell~commands
    while~downloading~the~font,~so~it~is~rejected.
  }

\msg_new:nnnn { ntfonts } { unsafe-path }
  { Refusing~to~download~font:~unsafe~#1~'#2'. }
  {
    The~#1~contains~a~shell~metacharacter.~Such~a~value~could
    inject~shell~commands~while~downloading~the~font,~so~it~is
    rejected.
  }

% \__nt_font_assert_token:nn {label} {value} — value must be a plain
% identifier; otherwise abort with an error naming the offending field.
\cs_new_protected:Npn \__nt_font_assert_token:nn #1 #2
  {
    \str_set:Ne \l__nt_font_check_str { #2 }
    \regex_match:nVF { \A[A-Za-z0-9._\-]+\Z } \l__nt_font_check_str
      { \msg_error:nnxx { ntfonts } { unsafe-token }
          { #1 } { \l__nt_font_check_str } }
  }

% \__nt_font_assert_path:nn {label} {value} — value must be free of
% shell metacharacters (quote/backtick/$/&/;/|/<>/()/backslash/newline).
\cs_new_protected:Npn \__nt_font_assert_path:nn #1 #2
  {
    \str_set:Ne \l__nt_font_check_str { #2 }
    \regex_match:nVT { [`'"$&;|<>()\\\n] } \l__nt_font_check_str
      { \msg_error:nnxx { ntfonts } { unsafe-path }
          { #1 } { \l__nt_font_check_str } }
  }

\cs_new_protected:Npn \nt_check_fonts:nnnnn #1 #2 #3 #4 #5
{
  % Validate every argument before it can reach a shell command.
  \__nt_font_assert_token:nn { format }       { #1 }
  \__nt_font_assert_token:nn { font~name }    { #2 }
  \__nt_font_assert_path:nn  { base~URL }     { #4 }
  \__nt_font_assert_path:nn  { target~folder }{ #5 }

  % Split variants by commas, then validate each one
  \seq_set_split:Nnn \l__nt_variants_seq { , } { #3 }
  \seq_map_inline:Nn \l__nt_variants_seq
    { \__nt_font_assert_token:nn { font~variant } { ##1 } }

  % Create target directory if it doesn't exist.  (\sys_shell:n is not a real
  % l3 function; use \sys_shell_now:x, which is defined and expands #5.)
  \file_if_exist:nF { #5/DO_NOT_REMOVE_THIS_FILE.txt }
  {
    \sys_if_platform_windows:TF
      { \sys_shell_now:x { mkdir~"#5" } }      % cmd.exe: creates intermediate dirs
      { \sys_shell_now:x { mkdir~-p~'#5' } }
  }

  % Process each variant
  \seq_map_inline:Nn \l__nt_variants_seq
  {
    \tl_set:Nn \l__nt_filename_tl { #2-##1.#1 }
    \tl_set:Nn \l__nt_remote_url_tl { #4/#2/#2-##1.#1 }
    \tl_set:Nn \l__nt_local_path_tl { #5/#2-##1.#1 }

    % Check if file already exists
    \file_if_exist:nTF { \l__nt_local_path_tl }
    {
      \iow_term:x { Font~' \l__nt_filename_tl '~already~exists. }
    }
    {
      \iow_term:x { Downloading~font~' \l__nt_filename_tl '~
                    from~' \l__nt_remote_url_tl '~
                    to~' \l__nt_local_path_tl '~ }

      % Download the font
      \nt_download_font:nn { \l__nt_remote_url_tl } { \l__nt_local_path_tl }
    }
  }
}


\tl_new:N \l_nt_cmd_output_tl

\cs_new_protected:Npn \nt_download_font:nn #1 #2
{
  % #1 = remote URL, #2 = local target path
  \bool_set_false:N \l_tmpa_bool

  % A download tool can only run with (unrestricted) shell escape.
  \sys_if_shell_unrestricted:F
    {
      \msg_error:nn { ntfonts } { shell-escape-required }
      \bool_set_true:N \l_tmpa_bool
    }

  % Probe curl (redirect only stderr so the version string is captured).
  \bool_if:NF \l_tmpa_bool
    {
      \iow_term:x { Trying:~'curl'... }
      \sys_get_shell:enN  {curl ~ --version ~ 2> ~ \c__nt_devnull_tl }
                          { \tl_trim_spaces:n }
                          \l_nt_cmd_output_tl
      \tl_if_blank:nF { \tl_use:N \l_nt_cmd_output_tl }
        {
          % -f: fail (no file written) on HTTP >=400, so the file-existence
          % check below is meaningful; -sS: quiet but still report real errors.
          \iow_term:x { Running: ~ curl ~ -fsSL ~ -o ~ '#2' ~ '#1'... }
          \sys_shell_now:x { curl ~ -fsSL ~ -o ~ '#2' ~ '#1' }
          \bool_set_true:N \l_tmpa_bool
        }
    }

  % Probe wget.
  \bool_if:NF \l_tmpa_bool
    {
      \iow_term:x { Trying: ~ 'wget'... }
      \sys_get_shell:enN  {wget ~ --version ~ 2> ~ \c__nt_devnull_tl }
                          { \tl_trim_spaces:n }
                          \l_nt_cmd_output_tl
      \tl_if_blank:nF { \tl_use:N \l_nt_cmd_output_tl }
        {
          \iow_term:x { Running: ~ wget ~ -q ~ -O ~ '#2' ~ '#1'... }
          \sys_shell_now:x { wget ~ -q ~ -O ~ '#2' ~ '#1' }
          \bool_set_true:N \l_tmpa_bool
        }
    }

  % Probe python3 (each interpreter runs only itself — no cross-calls).
  \bool_if:NF \l_tmpa_bool
    {
      \iow_term:x { Trying: ~ 'python3'... }
      \sys_get_shell:enN  {python3 ~ --version ~ 2> ~ \c__nt_devnull_tl }
                          { \tl_trim_spaces:n }
                          \l_nt_cmd_output_tl
      \tl_if_blank:nF { \tl_use:N \l_nt_cmd_output_tl }
        {
          \iow_term:x { Running: ~ python3 ~ urlretrieve('#1',~'#2')... }
          \sys_shell_now:x
            {
              python3 ~ -c ~ "import ~ urllib.request; ~
              urllib.request.urlretrieve('#1', ~ '#2')"
            }
          \bool_set_true:N \l_tmpa_bool
        }
    }

  % Probe python (reached only when python3 was not found).
  \bool_if:NF \l_tmpa_bool
    {
      \iow_term:x { Trying: ~ 'python'... }
      \sys_get_shell:enN  {python ~ --version ~ 2> ~ \c__nt_devnull_tl }
                          { \tl_trim_spaces:n }
                          \l_nt_cmd_output_tl
      \tl_if_blank:nF { \tl_use:N \l_nt_cmd_output_tl }
        {
          \iow_term:x { Running: ~ python ~ urlretrieve('#1',~'#2')... }
          \sys_shell_now:x
            {
              python ~ -c ~ "import ~ urllib.request; ~
              urllib.request.urlretrieve('#1', ~ '#2')"
            }
          \bool_set_true:N \l_tmpa_bool
        }
    }

  % Windows fallback: PowerShell (probe with 'where', not a malformed 'powershell /?"').
  \bool_if:NF \l_tmpa_bool
    {
      \sys_if_platform_windows:T
        {
          \iow_term:x { Trying: ~ 'powershell'... }
          \sys_get_shell:enN  {where ~ powershell ~ 2> ~ \c__nt_devnull_tl }
                              { \tl_trim_spaces:n }
                              \l_nt_cmd_output_tl
          \tl_if_blank:nF { \tl_use:N \l_nt_cmd_output_tl }
            {
              \iow_term:x
                {
                  powershell ~ -Command ~
                  "Invoke-WebRequest ~ -Uri ~ '#1' ~ -OutFile ~ '#2'"
                }
              \sys_shell_now:x
                {
                  powershell ~ -Command ~
                  "Invoke-WebRequest ~ -Uri ~ '#1' ~ -OutFile ~ '#2'"
                }
              \bool_set_true:N \l_tmpa_bool
            }
        }
    }

  % Verify the download actually produced a file (only when shell escape was
  % available; the disabled case already raised its own error above).  This
  % turns a silent failure (404, network down, no tool found) into an
  % actionable warning instead of a later "font not found" error.
  \sys_if_shell_unrestricted:T
    {
      \file_if_exist:nF { #2 }
        { \msg_warning:nnnn { ntfonts } { download-failed } { #1 } { #2 } }
    }
}


