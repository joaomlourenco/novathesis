% ---------------------------------------------------------
% 2. User Interface to Add Rules (replacement for \validprocessor)
% ---------------------------------------------------------

% Syntax: \AddValidProcessor{key}{list,of,engines}
\NewDocumentCommand { \AddValidProcessor } { m m }
  {
    \prop_gput:Nnn \g_novathesis_proc_rules_prop { #1 } { #2 }
  }

% ---------------------------------------------------------
% 3. The Main Validator
% ---------------------------------------------------------

% Message definition for the error
\msg_new:nnnn { novathesis } { invalid-processor }
  { Invalid~processor~for~"#1". }
  {
    You~are~using~\g_novathesis_current_engine_str~(la)tex,~
    but~"#1"~only~allows:~#2.
  }

\NewDocumentCommand { \ValidateLtxProcessor } { m m m }
  {
    % #1 = Univ, #2 = School, #3 = Degree

    % Reset flags
    \bool_set_false:N \l_novathesis_rule_found_bool

    % -----------------------------------------------------
    % A. Hierarchy Lookup (Univ/Sch/Deg -> Univ/Sch -> Univ)
    % -----------------------------------------------------

    % 1. Check Univ/School/Degree
    \prop_get:NeNTF \g_novathesis_proc_rules_prop { #1/#2/#3 }
      \l_novathesis_found_rule_tl
      { \bool_set_true:N \l_novathesis_rule_found_bool }
      {
        % 2. Check Univ/School
        \prop_get:NeNTF \g_novathesis_proc_rules_prop { #1/#2 }
          \l_novathesis_found_rule_tl
          { \bool_set_true:N \l_novathesis_rule_found_bool }
          {
            % 3. Check Univ
            \prop_get:NnNTF \g_novathesis_proc_rules_prop { #1 }
              \l_novathesis_found_rule_tl
              { \bool_set_true:N \l_novathesis_rule_found_bool }
              {
                % No rule found: Do nothing (Implicitly Valid)
              }
          }
      }

    % -----------------------------------------------------
    % B. Validation Logic
    % -----------------------------------------------------

    \bool_if:NT \l_novathesis_rule_found_bool
      {
        % Check if the current engine is in the allowed list
        \clist_if_in:NVF \l_novathesis_found_rule_tl
          \g_novathesis_current_engine_str
          {
            % ERROR: Engine not found in allowed list
            \msg_error:nnxx { novathesis } { invalid-processor }
              { #1/#2/#3 }
              { \clist_use:Nn \l_novathesis_found_rule_tl { ,~ } }
          }
      }
  }

% ---------------------------------------------------------
% 4. Helper: Print current processor name (The \pdfprocessor equivalent)
% ---------------------------------------------------------
\NewDocumentCommand { \PrintProcessorName } { }
  {
    \str_case:Vn \g_novathesis_current_engine_str
      {
        { pdf } { pdf(La)\TeX }
        { lua } { lua(La)\TeX }
        { xe }  { Xe(La)\TeX }
      }
  }




% ── File existence utilities ───────────────────────────────────────────
% \IfFileExistsInDirsTF, \IfFileExistsCase, \IfFontExistsCase,
% \InputIfFileExistsInDirsTF — starred (*) processes all matches;
% non-starred stops on first success

% Each file-search command below uses its OWN found-flag, so that nesting one
% inside another's action code cannot clobber the outer result (they used to
% share a single \l_file_found_bool).  \IfFileExistsInDirsTF sets its flag
% globally to escape the \group_begin:/\group_end: that scopes its scratch
% variables; the others set their flags locally.
\bool_new:N \g__nt_fileindirs_found_bool
\bool_new:N \l__nt_filecase_found_bool
\bool_new:N \l__nt_inputindirs_found_bool
% Scratch variables for \IfFileExistsInDirsTF, declared once (previously
% \tl_new was called inside the command body, which errored on the 2nd call).
\tl_new:N \l__nt_fileindirs_dir_tl
\tl_new:N \l__nt_fileindirs_path_tl
\tl_new:N \l__nt_fileindirs_lastchar_tl

\NewDocumentCommand { \IfFileExistsInDirsTF } { s O { } m m m m }
 {
  \bool_gset_false:N \g__nt_fileindirs_found_bool
  \group_begin:
    \clist_map_inline:nn { #4 }
     {
      \tl_set:Nn \l__nt_fileindirs_dir_tl { ##1 }
      \tl_trim_spaces:N \l__nt_fileindirs_dir_tl

      % Smart Slash Logic
      \tl_if_empty:NF \l__nt_fileindirs_dir_tl
       {
        \tl_set:Nx \l__nt_fileindirs_lastchar_tl
          { \tl_item:Nn \l__nt_fileindirs_dir_tl { -1 } }
        \str_if_eq:VnF \l__nt_fileindirs_lastchar_tl { / }
         { \tl_put_right:Nn \l__nt_fileindirs_dir_tl { / } }
       }

      % CONSTRUCT FULL PATH: Prefix + Dir + Filename
      \tl_set:Nx \l__nt_fileindirs_path_tl { #2 \l__nt_fileindirs_dir_tl #3 }

      \file_if_exist:nT { \l__nt_fileindirs_path_tl }
       {
        \bool_gset_true:N \g__nt_fileindirs_found_bool
        \xdef\ntfoundpath{ \l__nt_fileindirs_path_tl }
        #5
        \IfBooleanF { #1 } { \clist_map_break: }
       }
     }
  \group_end:

  \bool_if:NF \g__nt_fileindirs_found_bool { #6 }
 }


% \IfFileExistsCase*[search-path]{ {file1}{action1}, {file2}{action2} }{ default-action }
% * (Optional): logic defined in the underlying expl3 code.
% #2 (Optional): A specific directory or path to prepend to the filenames.
% #3 (Mandatory): A comma-separated list of pairs formatted as {filename}{code to run if found}.
% #4 (Mandatory): The "Else" branch. This code runs only if none of the files in your list are found.
\NewDocumentCommand { \IfFileExistsCase } { s O { } m m }
  {
    \bool_set_false:N \l__nt_filecase_found_bool
    \clist_map_inline:nn { #3 }
      {
        % ##1 is {filepath}{action}
        \__filecase_split_pair:nnn { #1 } { #2 } ##1
      }
    % Else branch
    \bool_if:NF \l__nt_filecase_found_bool { #4 }
  }

% #1: Starred status
% #2: Prefix
% #3: Filename
% #4: Action
\cs_new_protected:Npn \__filecase_split_pair:nnn #1 #2 #3 #4 
  {
    % 1. Construct the full path
    \tl_set:Nn \l_tmpa_tl { #2 #3 }
    
    \file_if_exist:nT { \l_tmpa_tl }
      {
        \bool_set_true:N \l__nt_filecase_found_bool

        \tl_set_eq:NN \l_tmpb_tl \l_tmpa_tl
        
        % Regex: Match a dot, followed by non-dots and non-slashes, until end of string.
        % This ensures we don't accidentally match a dot in a directory name (e.g. "ver.1/img").
        \regex_replace_once:nnN { \.[^./]*\Z } { } \l_tmpb_tl

        \xdef\ntfoundpath{ \l_tmpa_tl }
        \xdef\ntfoundpathnoext{ \l_tmpb_tl }
        #4
        
        % Break if not starred
        \bool_if:NF #1 { \clist_map_break: }
      }
  }


\NewDocumentCommand { \IfFontExistsCase } { s m m }
  {
    \bool_set_false:N \l_tmpa_bool
    \clist_map_inline:nn { #2 }
      {
        % Check if the command \IfFontExistsTF exists (provided by fontspec)
        \cs_if_exist:cTF { IfFontExistsTF }
          {
            \IfFontExistsTF { ##1 }
              {
                \bool_set_true:N \l_tmpa_bool
                % Execute the code #3, passing the found font name (##1)
                #3 { ##1 }
                % If starred, break the loop after the first match
                \IfBooleanT { #1 } { \clist_map_break: }
              }
              { } % Do nothing if font doesn't exist
          }
          {
            % Fallback if fontspec isn't loaded or engine is pdfLaTeX
            \typeout { NOVAthesis:~fontspec~not~loaded.%
              ~Skipping~font~check~for~##1. }
          }
      }
    
    % Optional: warning if NO fonts from the list were found
    \bool_if:NF \l_tmpa_bool 
      {
        \typeout
          { NOVAthesis:~Warning:~No~fonts~from~the~list~{ #2 }~were~found. }
      }
  }


% --------------------------------------------------------
% Input the file from the first dir list (if any)
% #1 = file name
% #2 = list of directories
% #3 = code if succeed [OPTIONAL]
% #4 = code if fails [OPTIONAL]

% 1. Create variables
\NewDocumentCommand { \InputIfFileExistsInDirsTF } { m m +m +m }
  {
    \bool_set_false:N \l__nt_inputindirs_found_bool

    % Iterate through directories (#2)
    \clist_map_inline:nn { #2 }
      {
        % Check if 'directory/filename' exists
        \file_if_exist:nTF { ##1 / #1 }
          {
            % A. Store the full path in the variable
            \tl_set:Nn \l_found_path_tl { ##1 / #1 }

            % B. Input the file
            \file_input:n { ##1 / #1 }

            % C. Execute Success Code (#3)
            #3

            % D. Mark found and break loop
            \bool_set_true:N \l__nt_inputindirs_found_bool
            \clist_map_break:
          }
          {}
      }

    % Handle 'Not Found' case
    \bool_if:NF \l__nt_inputindirs_found_bool
      { #4 }
  }




% Default bookmark level for \ChapterNoTitle items.
% Set to 1 inside \ntprint{frontmatter} so they nest under the Front Matter node.
\def\@nt@bkm@level { 0 }

% 1. Define the internal logic (accepts the argument as-is)
\cs_new_protected:Nn \__user_chapter_logic:n
 {
  % Note: Inside ExplSyntaxOn, spaces are ignored, so we don't need % at EOL
  \clearforchapter
  
  % Create the anchor. 
  % #1 is now the fully expanded string (e.g., "Project Alpha").
  \phantomsection%
  \bookmark[level=\@nt@bkm@level, dest=\HyperLocalCurrentHref] { #1 }
  
  % Reset spacing/formatting
  \noindent \ignorespaces
 }


% 2. Generate the variant that forces expansion ('e' = expand fully)
\cs_generate_variant:Nn \__user_chapter_logic:n { e }

% 3. User Interface
\NewDocumentCommand { \ChapterNoTitle } { m }
 {
  % Call the expanded variant.
  % This turns \ChapterNoTitle{\myMacro} into \__user_chapter_logic:n {Expanded Value}
  \__user_chapter_logic:e { #1 }
 }

\NewDocumentCommand { \UniquifyList } { m o }
  {
    \clist_set:Ne \l_tmpa_clist { #1 }
    \clist_remove_duplicates:N \l_tmpa_clist
    \IfValueTF { #2 }
      { \tl_set:Ne #2 { \clist_use:Nn \l_tmpa_clist { , } } }
      { \clist_use:Nn \l_tmpa_clist { , } }
  }

\ExplSyntaxOff

% ── Abstract order accumulator ────────────────────────────────────────
% abstractorder={lang=order-list} (or abstractorder={order-list}) entries
% are collected in \g__nt_abstractorder_seq and applied once by
% \@setabstractorder (called from nt-setup.sty after options are frozen).
\ExplSyntaxOn
\seq_new:N \g__nt_abstractorder_seq
\tl_new:N  \l__nt_ao_lang_tl
\tl_new:N  \l__nt_ao_val_tl
\cs_new_protected:Npn \@setabstractorder
  {
    \seq_map_inline:Nn \g__nt_abstractorder_seq
      {
        % ##1 is "lang=order-list"  or just "order-list" (main lang implied)
        \seq_set_split:Nnn \l_tmpa_seq { = } { ##1 }
        \int_compare:nNnTF { \seq_count:N \l_tmpa_seq } > { 1 }
          {
            \tl_set:Ne \l__nt_ao_lang_tl { \seq_item:Nn \l_tmpa_seq { 1 } }
            \tl_set:Ne \l__nt_ao_val_tl  { \seq_item:Nn \l_tmpa_seq { 2 } }
          }
          {
            \tl_set:Ne \l__nt_ao_lang_tl { \@LANG@MAIN }
            \tl_set:Nn \l__nt_ao_val_tl  { ##1 }
          }
        \MemSet * { AbstractOrder } { \l__nt_ao_lang_tl } { \l__nt_ao_val_tl }
      }
  }
\cs_new_protected:Npn \@addtoabstractorder #1
  {
    \seq_gput_right:Nn \g__nt_abstractorder_seq { #1 }
  }
\ExplSyntaxOff

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% DATA MANAGEMENT (MEMORY)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% --------------------------------------------------------
% Search if a data/memory is defined and returns value

\ExplSyntaxOn

% Define a boolean to track if a match was found inside the loop
\bool_new:N \l__memory_match_found_bool

% Command: \datamatchtf
% Syntax:  \datamatchtf{\match}{MEMORYDATA}(list,of,keys){TRUE}{FALSE}
%
% #1: The macro to store the result (\match)
% #2: The memory data container name (MEMORYDATA)
% #3: The list of keys to search (in parentheses)
% #4: True branch code
% #5: False branch code

\NewDocumentCommand { \datamatchtf } { s m m r() +m +m }
  {
    % Reset the found boolean to false at the start
    \bool_set_false:N \l__memory_match_found_bool

    % Iterate through the comma-separated list of keys (#4 now, due to argument shift).
    \exp_args:Ne \clist_map_inline:nn { #4 }
      {
        % Initialize #2 to empty
        \IfBooleanTF{#1}
          { 
            % STARRED: #2 is a NAME (e.g., "myVar"). 
            % Use \tl_set:cn to construct the csname from the string.
            \tl_set:ce { #2 } { } 
          }
          { 
            % NON-STARRED: #2 is a MACRO (e.g., \myVar). 
            % Use \tl_set:Nn to set it directly.
            \tl_set:Ne #2 { } 
          }
        
        % Look up key ##1 in the memstore property list for store #3
        \prop_if_in:ceT { g__mem_#3_prop } { ##1 }
          {
            % If the key exists in the store:
            % 1. Set the user's variable (#2) to the stored value.
            
            \IfBooleanTF{#1}
              { 
                % STARRED: #2 is a NAME (e.g., "myVar"). 
                % Use \tl_set:cn to construct the csname from the string.
                \tl_set:ce { #2 } { \prop_item:ce { g__mem_#3_prop } { ##1 } } 
              }
              { 
                % NON-STARRED: #2 is a MACRO (e.g., \myVar). 
                % Use \tl_set:Nn to set it directly.
                \tl_set:Ne #2 { \prop_item:ce { g__mem_#3_prop } { ##1 } } 
              }

            % 2. Mark that we found a match
            \bool_set_true:N \l__memory_match_found_bool

            % 3. Break the loop immediately
            \clist_map_break:
          }
      }

    % Execute the appropriate branch based on whether a match was found
    % True branch is #5, False branch is #6
    \bool_if:NTF \l__memory_match_found_bool
      { #5 } % Match found
      { #6 } % No match found
  }

\NewDocumentCommand { \datamatch } { s m m r() }
  {
    % Argument mapping:
    % #1 = Star (boolean)
    % #2 = Macro to set / Name of macro (if starred)
    % #3 = Data ID (memory context)
    % #4 = List of keys (inside parens)

    \IfBooleanTF{#1}
      { 
        % Starred version: call \datamatchtf*
        \datamatchtf* { #2 } { #3 } ( #4 )
      }
      { 
        % Non-starred version: call \datamatchtf
        \datamatchtf  { #2 } { #3 } ( #4 ) 
      }
      % --- True Branch (Match Found) ---
      { } 
      % --- False Branch (No Match) ---
      { 
        % Note: In expl3, spaces are ignored, so we use ~ for spaces in text.
        \ClassError { novathesis }
          { Could~not~find~' #3 '~defined~with~any~of~' ( #4 ) '! }
          { }
      }
  }

\NewDocumentCommand { \datamatchcs } { s m m r() }
  {
    \IfBooleanTF{#1}
    {
      % Using expl3 syntax to expand the first argument into a csname
      \exp_args:NNc \datamatch * { #2 } { #3 } ( #4 )
    }
    {
      % Using expl3 syntax to expand the first argument into a csname
      \exp_args:Nc \datamatch { #2 } { #3 } ( #4 )
    }
  
  }

\ExplSyntaxOff


