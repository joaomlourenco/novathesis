% Silence the harmless "multiple pdfs with page group included in a single
% page" warning emitted when several PDF logos (with transparency groups) are
% placed on one cover page.  This is a pdfTeX-only warning: LuaTeX does not
% emit it (and setting its \pdfvariable form here disturbs backend init), and
% XeTeX uses a different backend.  Guard on the primitive so it acts only
% where it exists (pdfTeX).
\ifdefined\pdfsuppresswarningpagegroup \pdfsuppresswarningpagegroup=1 \fi

