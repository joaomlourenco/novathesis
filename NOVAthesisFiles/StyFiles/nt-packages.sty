%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% WRITE-REGISTER GUARD (must come before any other \newwrite)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% pdflatex and xelatex are limited to 16 \write registers; LuaTeX allows 65536.
% Since 8.0 glossaries are handled by bib2gls and no longer consume registers,
% so the class floor dropped to 9 and a typical document fits comfortably
% within 16.  morewrites (which virtualises the pool but makes a pdflatex pass
% roughly 9x slower) is therefore NOT loaded by default.
%
% A document that overshoots the 16 registers -- reported as "No room for a
% new \write" -- can re-enable morewrites by defining \ntmorewrites BEFORE
% \documentclass:
%
%     \def\ntmorewrites{}
%     \documentclass{novathesis}
%
% or, with the build system, by passing FASTWRITES=0 (see the Makefile).
% LuaLaTeX never needs morewrites, so the switch is a no-op there.
%
% The extra consumers beyond the class floor are one register each for
% \listofalgorithms and \listoflistings (only when actually used), plus
% whatever the document's own packages allocate (e.g. minted, via fancyvrb).
% Only such register-heavy documents need \ntmorewrites.  (The symbols
% glossary costs nothing: under bib2gls "record" mode no glossary consumes a
% \write register, which is why 'symbols' is passed to glossaries-extra
% unconditionally further down.)
%
% Legacy note: \ntnomorewrites (the pre-8.0 opt-out) is now redundant, since
% skipping is the default; it is still honoured and overrides \ntmorewrites.
\RequirePackage{iftex}
\ifluatex\else
  \ifdefined\ntmorewrites
    \ifdefined\ntnomorewrites\else\RequirePackage{morewrites}\fi
  \fi
\fi

